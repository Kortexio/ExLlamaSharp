<div class="content-header exl-page-header px-0 pt-0">
    <div class="row align-items-start">
        <div class="@(Actions is not null ? "col-lg-7 col-md-6" : "col-sm-6")">
            <h1 class="m-0">@Title</h1>
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="text-muted mb-0 mt-1 exl-page-subtitle">@Subtitle</p>
            }
        </div>
        <div class="@(Actions is not null ? "col-lg-5 col-md-6" : "col-sm-6") text-md-right">
            @if (Actions is not null)
            {
                <div class="exl-page-actions mb-2">@Actions</div>
            }
            <ol class="breadcrumb justify-content-md-end mb-0 bg-transparent p-0">
                <li class="breadcrumb-item"><a href="/">Home</a></li>
                @if (!string.IsNullOrWhiteSpace(Parent))
                {
                    <li class="breadcrumb-item"><a href="@ParentHref">@Parent</a></li>
                }
                <li class="breadcrumb-item active">@(Breadcrumb ?? Title)</li>
            </ol>
        </div>
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Breadcrumb { get; set; }
    [Parameter] public string? Parent { get; set; }
    [Parameter] public string? ParentHref { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}
