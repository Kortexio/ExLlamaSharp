        <NavLink class="kx-nav-link" href="/usage" @onclick="NotifyNavigate">Usage</NavLink>
        <NavLink class="kx-nav-link" href="/team" @onclick="NotifyNavigate">Team</NavLink>
    </div>

    @if (AdvancedMode)
    {
        <div class="kx-nav-section">
            <div class="kx-nav-label">Advanced</div>
            <NavLink class="kx-nav-link" href="/adapters" @onclick="NotifyNavigate">Adapters</NavLink>
