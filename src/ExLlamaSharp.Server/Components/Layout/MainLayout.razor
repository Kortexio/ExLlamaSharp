@inherits LayoutComponentBase
@inject OnboardingState Onboarding
@inject NavigationManager Nav
@inject IJSRuntime Js

@if (IsLoginPage)
{
    <div class="login-page">
        <ErrorBoundary>
            <ChildContent>
                @Body
            </ChildContent>
            <ErrorContent Context="ex">
                <div class="login-box">
                    <div class="alert alert-danger">
                        <strong>Something went wrong.</strong>
                        <p class="mb-2 mt-2">@ex.Message</p>
                        <a class="btn btn-sm btn-primary" href="@Nav.Uri">Reload</a>
                    </div>
                </div>
            </ErrorContent>
        </ErrorBoundary>
    </div>
}
else
{
    <div class="wrapper @(AdvancedMode ? "mode-advanced" : "mode-simple")">
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">
            <ul class="navbar-nav">
                <li class="nav-item">
                    <a class="nav-link" data-widget="pushmenu" href="#" role="button" @onclick="ToggleSidebarAsync" @onclick:preventDefault>
                        <i class="fas fa-bars"></i>
                    </a>
                </li>
                <li class="nav-item d-none d-sm-inline-block">
                    <a href="/" class="nav-link"><i class="fas fa-home mr-1"></i> Home</a>
                </li>
            </ul>

            <ul class="navbar-nav ml-auto align-items-center">
                <li class="nav-item d-none d-md-block mr-2">
                    <span class="exl-mode-badge @(AdvancedMode ? "is-advanced" : "is-simple")">
                        @(AdvancedMode ? "Advanced" : "Simple")
                    </span>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" title="Help" @onclick="ShowHelp" @onclick:preventDefault>
                        <i class="far fa-question-circle"></i>
                    </a>
                </li>
                @if (_signedIn)
                {
                    <li class="nav-item">
                        <a class="nav-link" href="#" title="Sign out" @onclick="LogoutAsync" @onclick:preventDefault>
                            <i class="fas fa-sign-out-alt"></i>
                            <span class="d-none d-md-inline"> Logout</span>
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link" href="/login">
                            <i class="fas fa-sign-in-alt"></i>
                            <span class="d-none d-md-inline"> Login</span>
                        </a>
                    </li>
                }
            </ul>
        </nav>

        <aside class="main-sidebar sidebar-dark-exl elevation-4">
            <a href="/" class="brand-link" @onclick="CloseOverlayAsync">
                <span class="brand-image img-circle elevation-3 brand-mark">EX</span>
                <span class="brand-text">ExLlamaSharp</span>
            </a>

            <div class="sidebar">
                <div class="exl-user-panel">
                    <p class="exl-user-name">Admin Console</p>
                    <p class="exl-user-role">Local inference server</p>
                </div>

                <NavMenu AdvancedMode="AdvancedMode" OnNavigate="CloseOverlayAsync" />

                <div class="sidebar-footer p-3">
                    <button type="button" class="btn btn-block btn-outline-light btn-sm" @onclick="ToggleMode">
                        <i class="fas fa-sliders-h mr-1"></i>
                        @(AdvancedMode ? "Simple mode" : "Advanced mode")
                    </button>
                </div>
            </div>
        </aside>

        <div class="content-wrapper">
            <section class="content pt-3 pb-4">
                <div class="container-fluid">
                    <ErrorBoundary>
                        <ChildContent>
                            @Body
                        </ChildContent>
                        <ErrorContent Context="ex">
                            <div class="alert alert-danger">
                                <h5><i class="icon fas fa-ban"></i> Something went wrong in this page.</h5>
                                <p class="mb-2">@ex.Message</p>
                                <a class="btn btn-sm btn-primary" href="@Nav.Uri">Reload page</a>
                            </div>
                        </ErrorContent>
                    </ErrorBoundary>
                </div>
            </section>
        </div>

        <footer class="main-footer text-sm">
            <strong>ExLlamaSharp</strong> · Admin Console
            <div class="float-right d-none d-sm-inline-block">
                v1.4.0
            </div>
        </footer>
    </div>
}

@if (_helpOpen)
{
    <div class="modal fade show d-block" tabindex="-1" role="dialog" style="background: rgba(15,23,42,.45);" @onclick="() => _helpOpen = false">
        <div class="modal-dialog modal-dialog-centered" role="document" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header border-0 pb-0">
                    <h5 class="modal-title font-weight-bold">Quick help</h5>
                    <button type="button" class="close" @onclick="() => _helpOpen = false">
                        <span>&times;</span>
                    </button>
                </div>
                <div class="modal-body">
                    <ul class="mb-3 pl-3">
                        <li class="mb-1"><a href="/setup">Setup wizard</a> — first-run configuration</li>
                        <li class="mb-1"><a href="/diagnostics">Diagnostics</a> — health checks</li>
                        <li class="mb-1"><a href="/api">API guide</a> — curl examples</li>
                        <li class="mb-1"><a href="/about">About</a> — version &amp; GPU</li>
                    </ul>
                    <p class="text-muted small mb-0">
                        Toggle <strong>Simple / Advanced</strong> in the sidebar to show or hide power-user metrics.
                    </p>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-sm btn-primary" @onclick="() => _helpOpen = false">Got it</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool AdvancedMode { get; set; }
    private bool _helpOpen;
    private bool _signedIn;

    private bool IsLoginPage
    {
        get
        {
            try
            {
                var path = new Uri(Nav.Uri).AbsolutePath.TrimEnd('/');
                return path.Equals("/login", StringComparison.OrdinalIgnoreCase);
            }
            catch
            {
                return false;
            }
        }
    }

    protected override void OnInitialized()
    {
        AdvancedMode = Onboarding.AdvancedMode;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _signedIn = await Js.InvokeAsync<bool>("exLlamaSharpAdmin.hasApiKeyCookie");
            if (_signedIn)
            {
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (JSException)
        {
        }
    }

    private void ToggleMode()
    {
        AdvancedMode = !AdvancedMode;
        Onboarding.AdvancedMode = AdvancedMode;
    }

    private void ShowHelp() => _helpOpen = true;

    private async Task LogoutAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("exLlamaSharpAdmin.logoutSession");
            await Js.InvokeVoidAsync("exLlamaSharpAdmin.clearApiKeyCookie");
        }
        catch (JSException)
        {
        }

        Nav.NavigateTo("/login", forceLoad: true);
    }

    private async Task ToggleSidebarAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("exLlamaSharpAdmin.toggleSidebar");
        }
        catch (JSException)
        {
        }
    }

    private async Task CloseOverlayAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("exLlamaSharpAdmin.closeSidebarOverlay");
        }
        catch (JSException)
        {
        }
    }
}
