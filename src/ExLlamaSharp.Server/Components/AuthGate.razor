@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IHttpContextAccessor Http

@if (_ready)
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _ready;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        var path = Nav.ToBaseRelativePath(Nav.Uri);
        var q = path.IndexOf('?', StringComparison.Ordinal);
        if (q >= 0)
        {
            path = path[..q];
        }

        var h = path.IndexOf('#', StringComparison.Ordinal);
        if (h >= 0)
        {
            path = path[..h];
        }

        path = path.Trim('/');
        var isPublic = path is "login" or "setup" or "about"
            || path.StartsWith("login/", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("setup/", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("about/", StringComparison.OrdinalIgnoreCase);

        if (isPublic)
        {
            _ready = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        var hasCookie = Http.HttpContext?.Request.Cookies.ContainsKey("exllamasharp_key") == true;
        if (!hasCookie)
        {
            try
            {
                hasCookie = await Js.InvokeAsync<bool>("exLlamaSharpAdmin.hasApiKeyCookie");
            }
            catch (JSException)
            {
                hasCookie = false;
            }
        }

        if (!hasCookie)
        {
            Nav.NavigateTo("/login", forceLoad: false);
            return;
        }

        _ready = true;
        await InvokeAsync(StateHasChanged);
    }
}
