@implements IDisposable
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IHttpContextAccessor Http
@inject AdminUiSession Session
@inject KeyCacheService KeyCache
@inject AppDbContext Db
@using ExLlamaSharp.Server.Auth
@using Microsoft.EntityFrameworkCore

@if (_ready)
{
    @ChildContent
}

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private bool _ready;
    private bool _checking;
    private bool _redirecting;

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
        => firstRender ? EvaluateAsync() : Task.CompletedTask;

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => _ = InvokeAsync(EvaluateAsync);

    private async Task EvaluateAsync()
    {
        if (_checking)
        {
            return;
        }

        _checking = true;
        try
        {
            var hasUsers = await Db.Users.AsNoTracking().AnyAsync();

            if (IsPublicPath(Nav.Uri))
            {
                // Empty install: Login is useless — send people to Setup to create admin.
                if (!hasUsers && IsLoginPath(Nav.Uri))
                {
                    if (!_redirecting)
                    {
                        _redirecting = true;
                        Nav.NavigateTo("/setup", forceLoad: false);
                    }

                    return;
                }

                _redirecting = false;
                _ready = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            if (!hasUsers)
            {
                _ready = false;
                await InvokeAsync(StateHasChanged);
                if (!_redirecting)
                {
                    _redirecting = true;
                    Nav.NavigateTo("/setup", forceLoad: false);
                }

                return;
            }

            var key = await ResolveSessionKeyAsync();
            if (string.IsNullOrWhiteSpace(key) || !await IsValidKeyAsync(key))
            {
                Session.ApiKey = null;
                await ClearBrowserSessionAsync();
                _ready = false;
                await InvokeAsync(StateHasChanged);
                if (!_redirecting)
                {
                    _redirecting = true;
                    Nav.NavigateTo("/login", forceLoad: false);
                }

                return;
            }

            Session.ApiKey = key;
            _redirecting = false;
            _ready = true;
            await InvokeAsync(StateHasChanged);
        }
        finally
        {
            _checking = false;
        }
    }

    private async Task<string?> ResolveSessionKeyAsync()
    {
        if (!string.IsNullOrWhiteSpace(Session.ApiKey))
        {
            return Session.ApiKey;
        }

        if (Http.HttpContext?.Request.Cookies.TryGetValue("exllamasharp_key", out var cookie) == true
            && !string.IsNullOrWhiteSpace(cookie))
        {
            return cookie;
        }

        try
        {
            var fromJs = await Js.InvokeAsync<string?>("exLlamaSharpAdmin.getApiKeyCookie");
            return string.IsNullOrWhiteSpace(fromJs) ? null : fromJs;
        }
        catch (JSException)
        {
            return null;
        }
    }

    private async Task<bool> IsValidKeyAsync(string key)
    {
        try
        {
            var apiKey = await KeyCache.GetAsync(ApiKeyHasher.Hash(key));
            return apiKey is not null;
        }
        catch
        {
            return false;
        }
    }

    private async Task ClearBrowserSessionAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("exLlamaSharpAdmin.logoutSession");
            await Js.InvokeVoidAsync("exLlamaSharpAdmin.clearApiKeyCookie");
        }
        catch (JSException)
        {
            try { await Js.InvokeVoidAsync("exLlamaSharpAdmin.clearApiKeyCookie"); } catch (JSException) { }
        }
    }

    private bool IsPublicPath(string uri)
    {
        var path = RelativePath(uri);
        return path is "login" or "setup" or "about"
            || path.StartsWith("login/", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("setup/", StringComparison.OrdinalIgnoreCase)
            || path.StartsWith("about/", StringComparison.OrdinalIgnoreCase);
    }

    private bool IsLoginPath(string uri)
    {
        var path = RelativePath(uri);
        return path is "login" || path.StartsWith("login/", StringComparison.OrdinalIgnoreCase);
    }

    private string RelativePath(string uri)
    {
        var path = Nav.ToBaseRelativePath(uri);
        var q = path.IndexOf('?', StringComparison.Ordinal);
        if (q >= 0)
        {
            path = path[..q];
        }

        var h = path.IndexOf('#', StringComparison.Ordinal);
        if (h >= 0)
        {
            path = path[..h];
        }

        return path.Trim('/');
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }
}
