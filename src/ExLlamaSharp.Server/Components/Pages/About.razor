@page "/about"
@inject AboutService AboutSvc
@inject UpdateCheckService Updates

<PageTitle>About — ExLlamaSharp</PageTitle>

<PageHeader Title="About" Subtitle="Build, runtime, and updates." />

@if (_update is { UpdateAvailable: true })
{
    <div class="alert alert-info d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <strong><i class="fas fa-cloud-download-alt mr-1"></i> Update available</strong>
            <div class="small mb-0">@_update.Message</div>
        </div>
        <div class="d-flex gap-2">
            @if (!string.IsNullOrWhiteSpace(_update.DownloadUrl))
            {
                <a class="btn btn-primary btn-sm" href="@_update.DownloadUrl" target="_blank" rel="noopener">
                    <i class="fas fa-download mr-1"></i> Download installer
                </a>
            }
            @if (!string.IsNullOrWhiteSpace(_update.ReleaseUrl))
            {
                <a class="btn btn-outline-secondary btn-sm" href="@_update.ReleaseUrl" target="_blank" rel="noopener">
                    Release notes
                </a>
            }
        </div>
    </div>
}
else if (_update is { Checked: true, UpdateAvailable: false })
{
    <div class="alert alert-success py-2">
        <i class="fas fa-check-circle mr-1"></i> @_update.Message
        <button type="button" class="btn btn-link btn-sm p-0 ml-2" @onclick="RefreshUpdateAsync" disabled="@_checking">Check again</button>
    </div>
}
else if (_updateError is not null)
{
    <div class="alert alert-secondary py-2">
        <i class="fas fa-info-circle mr-1"></i> Could not check for updates: @_updateError
        <button type="button" class="btn btn-link btn-sm p-0 ml-2" @onclick="RefreshUpdateAsync" disabled="@_checking">Retry</button>
    </div>
}

@if (_info is null)
{
    <div class="alert alert-warning"><i class="fas fa-exclamation-triangle mr-1"></i> Unable to load about info.</div>
}
else
{
    <div class="stat-grid mb-3">
        <div class="card"><div class="card-body"><div class="stat-label">Version</div><div class="stat-value" style="font-size:1.2rem">@_info.Version</div></div></div>
        <div class="card"><div class="card-body"><div class="stat-label">Build</div><div>@(_info.BuildDate?.ToLocalTime().ToString("g") ?? "—")</div></div></div>
        <div class="card"><div class="card-body"><div class="stat-label">.NET</div><div>@_info.Runtime.Dotnet</div></div></div>
        <div class="card"><div class="card-body"><div class="stat-label">OS</div><div class="small">@_info.Runtime.Os</div></div></div>
    </div>

    <div class="card card-outline card-primary mb-3">
        <div class="card-header"><h3 class="card-title"><i class="fas fa-cogs mr-2"></i>Engine</h3></div>
        <div class="card-body">
            <ul class="mb-0">
                <li>Mock: @_info.Engine.IsMock</li>
                <li>Loaded: @_info.Engine.IsLoaded</li>
                <li>Running: @_info.Engine.IsRunning</li>
                <li>Model: @(_info.Engine.LoadedModelPath ?? "—")</li>
                <li>TPS: @(_info.Engine.TokensPerSecond?.ToString("0.0") ?? "—")</li>
            </ul>
        </div>
    </div>

    <div class="card card-outline card-secondary">
        <div class="card-header"><h3 class="card-title"><i class="fas fa-microchip mr-2"></i>GPU</h3></div>
        <div class="card-body">
            @if (_info.Gpu.Available)
            {
                <div class="kx-chip-row mb-2">
                    @if (_info.Gpu.Devices.Count > 0)
                    {
                        @foreach (var g in _info.Gpu.Devices)
                        {
                            var cuda = g.CudaIndex is int c ? $"cuda:{c}" : "not in CUDA_VISIBLE_DEVICES";
                            var label = $"PCI {g.Index} · {cuda} · {g.Name} · {g.VramUsedMb:0}/{g.VramTotalMb:0} MB";
                            if (g.DisplayActive == true) { label += " · display"; }
                            <span class="kx-chip" title="@(string.IsNullOrEmpty(g.Uuid) ? label : $"{label} · {g.Uuid}")">@label</span>
                        }
                    }
                    else
                    {
                        <span class="kx-chip">@_info.Gpu.Name</span>
                        <span class="kx-chip">VRAM: @(_info.Gpu.VramTotalMb?.ToString("0") ?? "?") MB</span>
                    }
                </div>
                <p class="text-muted small mb-0">Primary (highest VRAM): @_info.Gpu.Name</p>
            }
            else
            {
                <p class="text-muted mb-0">No NVIDIA GPU detected via nvidia-smi.</p>
            }
        </div>
    </div>
}

@code {
    private AboutInfo? _info;
    private UpdateCheckResult? _update;
    private string? _updateError;
    private bool _checking;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _info = AboutSvc.GetAbout();
        }
        catch
        {
            _info = null;
        }

        await RefreshUpdateAsync().ConfigureAwait(false);
    }

    private async Task RefreshUpdateAsync()
    {
        _checking = true;
        _updateError = null;
        try
        {
            _update = await Updates.CheckAsync().ConfigureAwait(false);
            if (!_update.Checked)
            {
                _updateError = _update.Message;
            }
        }
        catch (Exception ex)
        {
            _update = null;
            _updateError = ex.Message;
        }
        finally
        {
            _checking = false;
        }
    }
}
