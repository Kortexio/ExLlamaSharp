@page "/models"
@inject AppDbContext Db
@inject EngineHostService Engine
@inject ModelInventoryService Inventory
@inject HuggingFaceCatalogService HuggingFace
@inject ModelJobsService Jobs
@inject GpuInfoService GpuInfo
@inject SettingsService Settings
@inject VramFitService VramFit
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@using Microsoft.EntityFrameworkCore
@using ExLlamaSharp.Server.Services.Ui
@using System.Net.Http.Json

<PageTitle>Models — ExLlamaSharp</PageTitle>

<div class="page-header">
    <h1>Models</h1>
    <p>Library, installed models, import, and quantize.</p>
</div>

<p class="form-text mb-3">@_gpuCaption</p>

<div class="tabs">
    <button class="tab-btn @(Tab == "library" ? "active" : "")" @onclick='() => Tab = "library"'>Library</button>
    <button class="tab-btn @(Tab == "mine" ? "active" : "")" @onclick='() => Tab = "mine"'>My Models</button>
    <button class="tab-btn @(Tab == "import" ? "active" : "")" @onclick='() => Tab = "import"'>Import</button>
    <button class="tab-btn @(Tab == "quantize" ? "active" : "")" @onclick='() => Tab = "quantize"'>Quantize</button>
</div>

@if (Tab == "library")
{
    <div class="card mb-3">
        <div class="card-body">
            <div class="d-flex flex-wrap gap-2 align-items-end">
                <div class="flex-grow-1">
                    <label class="form-label">Search Hugging Face</label>
                    <input class="form-control" @bind="_hfQuery" @bind:event="oninput" placeholder="exl3, llama, qwen…" @onkeydown="OnSearchKey" />
                </div>
                <button class="btn btn-primary" disabled="@_searching" @onclick="SearchHuggingFaceAsync">
                    @(_searching ? "Searching…" : "Search")
                </button>
            </div>
            <p class="form-text mb-0 mt-2">
                Prefer standalone <code>exl3</code> chat/VLM models. Drafts (DFlash), GGUF, and incomplete repos are hidden.
            </p>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert-soft mb-3">@_msg</div>
    }
    <div class="card">
        <div class="card-body p-0">
            <table class="table-clean">
                <thead>
                    <tr><th>Name</th><th>Repo</th><th>Params</th><th>Size</th><th>VRAM</th><th></th></tr>
                </thead>
                <tbody>
                    @if (_hfHits.Count == 0 && !_searching)
                    {
                        <tr><td colspan="6" class="text-muted">No Hugging Face results. Try “exl3” or check your network / HF token.</td></tr>
                    }
                    @foreach (var m in _hfHits)
                    {
                        var fit = VramFit.Evaluate(m.SizeBytes, _gpus, _gpuUtil, _gpuSplitGb);
                        <tr>
                            <td>@m.DisplayName</td>
                            <td><code>@m.RepoId</code></td>
                            <td>@(m.ParameterLabel ?? "—")</td>
                            <td>@(m.SizeBytes is null ? "…" : m.SizeBytes > 0 ? HuggingFaceCatalogService.FormatBytes(m.SizeBytes.Value) : "—")</td>
                            <td><span class="badge-status @fit.BadgeClass" title="@fit.Detail">@fit.Label</span></td>
                            <td><button class="btn btn-sm btn-outline-primary" disabled="@_pulling" @onclick="() => PullAsync(m.RepoId, m.DisplayName)">Download</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
else if (Tab == "mine")
{
    @if (Engine.IsLoaded && Engine.LoadedModelPath is { } loadedPath)
    {
        <div class="alert-soft mb-3 d-flex flex-wrap gap-2 align-items-center justify-content-between">
            <span>Loaded now: <code>@Path.GetFileName(loadedPath.TrimEnd(Path.DirectorySeparatorChar))</code></span>
            <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="UnloadAsync">Unload</button>
        </div>
    }
    <div class="d-flex flex-wrap gap-2 mb-3 align-items-center">
        <button class="btn btn-sm btn-outline-danger" disabled="@(!_busy && _loadingId is null)" @onclick="CancelLoadUiAsync">Cancel load</button>
        @if (_loadingId is not null)
        {
            <div class="flex-grow-1" style="min-width:12rem">
                <div class="progress-thin"><span style="width:@(_loadPct.ToString("0"))%"></span></div>
                <div class="form-text mb-0">
                    @(string.IsNullOrEmpty(_loadPhase) ? "Loading" : _loadPhase)
                    @if (_loadPct > 0) { <text> · @_loadPct%</text> }
                    @if (_loadElapsedSec > 0) { <text> · @_loadElapsedSec.ToString("0")s</text> }
                </div>
            </div>
        }
    </div>
    <div class="card">
        <div class="card-body p-0">
            <table class="table-clean">
                <thead>
                    <tr><th>Alias</th><th>Folder</th><th>Size</th><th>Quant</th><th>VRAM</th><th>Status</th><th></th></tr>
                </thead>
                <tbody>
                    @if (_mine.Count == 0)
                    {
                        <tr><td colspan="7" class="text-muted">No local models. Import or pull one.</td></tr>
                    }
                    @foreach (var m in _mine)
                    {
                        var fit = VramFit.EvaluateGb(m.SizeGb, _gpus, _gpuUtil, _gpuSplitGb);
                        var isLoaded = IsLoadedModel(m);
                        var isLoading = _loadingId == m.Id;
                        var folderName = Path.GetFileName(m.Path.TrimEnd(Path.DirectorySeparatorChar));
                        <tr class="@(isLoaded ? "table-row-active" : null)">
                            <td>
                                @if (_editingAliasId == m.Id)
                                {
                                    <div class="d-flex flex-wrap gap-1 align-items-center">
                                        <input class="form-control form-control-sm" style="min-width:8rem" @bind="_aliasDraft" />
                                        <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => SaveAliasAsync(m)">Save</button>
                                        <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <span>@(string.IsNullOrWhiteSpace(m.Alias) ? folderName : m.Alias)</span>
                                }
                            </td>
                            <td><code title="@m.Path">@folderName</code></td>
                            <td>@FormatSizeGb(m.SizeGb)</td>
                            <td>@(m.QuantMode ?? "—")</td>
                            <td><span class="badge-status @fit.BadgeClass" title="@fit.Detail">@fit.Label</span></td>
                            <td>
                                @if (isLoading)
                                {
                                    <span class="badge-status badge-warn">
                                        @(string.IsNullOrEmpty(_loadPhase) ? "Loading…" : $"Loading {_loadPhase} {_loadPct}%")
                                    </span>
                                }
                                else if (isLoaded)
                                {
                                    <span class="badge-status badge-ok">Loaded</span>
                                }
                                else if (!Directory.Exists(m.Path))
                                {
                                    <span class="badge-status badge-err" title="@m.Path">Missing</span>
                                }
                                else if (!HasWeights(m.Path))
                                {
                                    <span class="badge-status badge-warn" title="No .safetensors weights found">Incomplete</span>
                                }
                                else
                                {
                                    <span class="text-muted">Ready</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex flex-wrap gap-1">
                                    @if (isLoaded)
                                    {
                                        <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="UnloadAsync">Unload</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-primary" disabled="@(_busy || isLoading)" @onclick="() => LoadModel(m)">
                                            @(isLoading ? "Loading…" : "Load")
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => BeginEditAlias(m)">Alias</button>
                                    <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="() => RenameFolderAsync(m)">Rename</button>
                                    <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => DeleteModelAsync(m, deleteFiles: false)">Remove</button>
                                    <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="() => DeleteModelAsync(m, deleteFiles: true)">Delete files</button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert-soft mt-3">@_msg</div>
    }
}
else if (Tab == "quantize")
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Quantize to EXL3</h5>
            <div class="form-grid">
                <div>
                    <label class="form-label">Source model</label>
                    <select class="form-select" @bind="_quantizeModelId">
                        <option value="">— select installed —</option>
                        @foreach (var m in _mine)
                        {
                            <option value="@m.Id">@(m.Alias ?? m.Path)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label">Or source path</label>
                    <input class="form-control" @bind="_quantizePath" placeholder="D:\models\fp16-model" />
                </div>
                <div>
                    <label class="form-label">Bits</label>
                    <input type="number" step="0.25" class="form-control" @bind="_quantizeBits" />
                </div>
                <button class="btn btn-primary" disabled="@_busy" @onclick="QuantizeAsync">Start quantize</button>
            </div>
            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="alert-soft mt-3">@_msg</div>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Import local folder</h5>
            <div class="form-grid">
                <div>
                    <label class="form-label">Model path</label>
                    <input class="form-control" @bind="_importPath" placeholder="D:\models\my-exl2" />
                </div>
                <div>
                    <label class="form-label">Alias</label>
                    <input class="form-control" @bind="_importAlias" />
                </div>
                <button class="btn btn-primary" @onclick="ImportAsync">Import</button>
            </div>
            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="alert-soft mt-3">@_msg</div>
            }
        </div>
    </div>
}

@code {
    private string Tab = "library";
    private List<HuggingFaceModelHit> _hfHits = [];
    private List<ModelRecord> _mine = [];
    private string _importPath = "";
    private string _importAlias = "";
    private string _hfQuery = "exl3";
    private string? _msg;
    private bool _searching;
    private bool _pulling;
    private bool _busy;
    private Guid? _loadingId;
    private string? _loadPhase;
    private int _loadPct;
    private double _loadElapsedSec;
    private Guid? _editingAliasId;
    private string _aliasDraft = "";
    private string _quantizeModelId = "";
    private string _quantizePath = "";
    private double _quantizeBits = 4.0;
    private IReadOnlyList<GpuSnapshot> _gpus = [];
    private double _gpuUtil = VramFitService.DefaultGpuUtilization;
    private string? _gpuSplitGb;
    private string? _cudaVisible;
    private string _gpuCaption = "Reading GPU VRAM…";

    protected override async Task OnInitializedAsync()
    {
        await LoadGpuAsync();
        await ReloadAsync();
        await SearchHuggingFaceAsync();
    }

    private HttpClient CreateApi()
    {
        var client = HttpClientFactory.CreateClient("local-api");
        client.BaseAddress ??= new Uri(Nav.BaseUri);
        return client;
    }

    private static string FormatSizeGb(double gb)
    {
        if (gb < 0.05)
        {
            return "—";
        }

        return gb < 10 ? $"{gb:0.00} GB" : $"{gb:0.0} GB";
    }

    private static bool HasWeights(string path)
    {
        try
        {
            return Directory.Exists(path)
                && Directory.EnumerateFiles(path, "*.safetensors", SearchOption.AllDirectories).Any();
        }
        catch
        {
            return false;
        }
    }

    private bool IsLoadedModel(ModelRecord m)
    {
        if (!Engine.IsLoaded || string.IsNullOrWhiteSpace(Engine.LoadedModelPath))
        {
            return false;
        }

        if (Engine.LoadedModelId == m.Id)
        {
            return true;
        }

        try
        {
            return string.Equals(
                Path.GetFullPath(Engine.LoadedModelPath.TrimEnd(Path.DirectorySeparatorChar)),
                Path.GetFullPath(m.Path.TrimEnd(Path.DirectorySeparatorChar)),
                StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private async Task LoadGpuAsync()
    {
        _gpuSplitGb = null;
        _cudaVisible = null;
        try
        {
            var settings = await Settings.GetAsync();
            _gpuUtil = settings.GpuMemoryUtilization;
            _gpuSplitGb = settings.GpuSplitGb;
            _cudaVisible = settings.CudaVisibleDevices;
        }
        catch
        {
            _gpuUtil = VramFitService.DefaultGpuUtilization;
        }

        try
        {
            var all = await GpuInfo.GetGpusAsync();
            _gpus = GpuInfoService.FilterVisible(all, _cudaVisible);
        }
        catch
        {
            _gpus = [];
        }

        _gpuCaption = VramFitService.FormatGpuCaption(_gpus, _gpuUtil, _cudaVisible, _gpuSplitGb);
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchHuggingFaceAsync();
        }
    }

    private async Task SearchHuggingFaceAsync()
    {
        _searching = true;
        _msg = null;
        try
        {
            _hfHits = HuggingFaceCatalogService.FilterLoadableHits(await HuggingFace.SearchAsync(_hfQuery)).ToList();
            if (_hfHits.Count == 0)
            {
                _msg = "No loadable EXL3 models for that search (drafts / incomplete repos are filtered out).";
            }
            else
            {
                _ = EnrichLibraryAsync();
            }
        }
        catch (Exception ex)
        {
            _hfHits = [];
            _msg = ex.Message;
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task EnrichLibraryAsync()
    {
        var snapshot = _hfHits;
        try
        {
            await HuggingFace.EnrichHitsAsync(snapshot);
            _hfHits = HuggingFaceCatalogService.FilterLoadableHits(snapshot).ToList();
            if (_hfHits.Count == 0)
            {
                _msg = "No loadable EXL3 models after checking weights/tokenizer (incomplete Hub repos were removed).";
            }
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // size is optional; params from the repo name already show
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            await Inventory.SyncFromDiskAsync();
            foreach (var e in Db.ChangeTracker.Entries().ToList())
            {
                e.State = EntityState.Detached;
            }

            _mine = await Db.Models.AsNoTracking().OrderByDescending(x => x.CreatedAt).Take(100).ToListAsync();
        }
        catch
        {
            _mine = [];
        }
    }

    private async Task RefreshMineAsync()
    {
        _busy = true;
        _msg = null;
        try
        {
            await Inventory.RefreshAllSizesAsync();
            await ReloadAsync();
            _msg = "Sizes refreshed from disk.";
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelLoadUiAsync()
    {
        try
        {
            var client = CreateApi();
            await client.PostAsync("/api/v1/models/load-cancel", null);
            _msg = "Load cancelled.";
            _loadingId = null;
            _busy = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
    }

    private async Task PullAsync(string repoId, string displayName)
    {
        var probe = new HuggingFaceModelHit
        {
            RepoId = repoId,
            DisplayName = displayName,
            Tags = repoId,
        };
        if (!HuggingFaceCatalogService.IsStandaloneExl3Candidate(probe))
        {
            _msg = $"Skipped {displayName}: not a standalone EXL3 chat/VLM model (drafts like DFlash are not supported).";
            return;
        }

        _pulling = true;
        _msg = $"Downloading {displayName} from Hugging Face… this can take several minutes.";
        try
        {
            var job = await Jobs.EnqueuePullAsync(repoId);
            _msg = $"Download started ({displayName}). Job {job.JobId:N} — watch Jobs, then My Models.";
            Tab = "mine";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _pulling = false;
        }
    }

    private void BeginEditAlias(ModelRecord model)
    {
        _editingAliasId = model.Id;
        _aliasDraft = model.Alias ?? Path.GetFileName(model.Path.TrimEnd(Path.DirectorySeparatorChar));
        _msg = null;
    }

    private void CancelEdit()
    {
        _editingAliasId = null;
        _aliasDraft = "";
    }

    private async Task SaveAliasAsync(ModelRecord model)
    {
        _busy = true;
        _msg = null;
        try
        {
            var client = CreateApi();
            var resp = await client.PostAsJsonAsync("/api/v1/models/alias", new
            {
                model_id = model.Id,
                alias = _aliasDraft?.Trim() ?? "",
            });
            var body = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _msg = body;
                return;
            }

            _editingAliasId = null;
            _msg = "Alias saved.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RenameFolderAsync(ModelRecord model)
    {
        var current = Path.GetFileName(model.Path.TrimEnd(Path.DirectorySeparatorChar));
        var name = await Js.InvokeAsync<string?>("prompt", "New folder name on disk:", current);
        if (string.IsNullOrWhiteSpace(name) || string.Equals(name.Trim(), current, StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _busy = true;
        _msg = null;
        try
        {
            var client = CreateApi();
            var resp = await client.PostAsJsonAsync("/api/v1/models/rename", new
            {
                model_id = model.Id,
                folder_name = name.Trim(),
            });
            var body = await resp.Content.ReadAsStringAsync();
            _msg = resp.IsSuccessStatusCode ? $"Renamed folder to {name.Trim()}." : body;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteModelAsync(ModelRecord model, bool deleteFiles)
    {
        var label = string.IsNullOrWhiteSpace(model.Alias)
            ? Path.GetFileName(model.Path.TrimEnd(Path.DirectorySeparatorChar))
            : model.Alias;
        var confirm = deleteFiles
            ? $"Delete '{label}' from the library AND erase files on disk?\n{model.Path}"
            : $"Remove '{label}' from My Models? (files stay on disk)";
        if (!await Js.InvokeAsync<bool>("confirm", confirm))
        {
            return;
        }

        _busy = true;
        _msg = null;
        try
        {
            var client = CreateApi();
            var url = $"/api/v1/models/{model.Id}?delete_files={(deleteFiles ? "true" : "false")}";
            var resp = await client.DeleteAsync(url);
            var body = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _msg = body;
                return;
            }

            _msg = deleteFiles ? $"Deleted {label} and files." : $"Removed {label} from library.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task LoadModel(ModelRecord model)
    {
        var label = string.IsNullOrWhiteSpace(model.Alias)
            ? Path.GetFileName(model.Path.TrimEnd(Path.DirectorySeparatorChar))
            : model.Alias;

        if (!Directory.Exists(model.Path))
        {
            _msg = $"Load failed: folder missing — {model.Path}";
            return;
        }

        if (!HasWeights(model.Path))
        {
            _msg = $"Load failed: incomplete model (no .safetensors) — {label}";
            return;
        }

        _busy = true;
        _loadingId = model.Id;
        _loadPhase = "starting";
        _loadPct = 1;
        _loadElapsedSec = 0;
        _msg = $"Loading {label}… this can take 1–3 minutes. UI stays responsive.";
        await InvokeAsync(StateHasChanged);
        try
        {
            var client = CreateApi();
            var resp = await client.PostAsJsonAsync("/api/v1/models/load", new
            {
                model_id = model.Id,
                path = model.Path,
                background = true,
            });
            var body = await resp.Content.ReadAsStringAsync();
            if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _msg = "Another model is already loading. Wait for it to finish.";
                return;
            }

            if (!resp.IsSuccessStatusCode)
            {
                _msg = $"Load failed: {body}";
                return;
            }

            // Poll status so the Blazor circuit is not blocked inside Engine.LoadAsync.
            var deadline = DateTime.UtcNow.AddMinutes(10);
            while (DateTime.UtcNow < deadline)
            {
                await Task.Delay(1500);
                var statusResp = await client.GetAsync("/api/v1/models/load-status");
                if (!statusResp.IsSuccessStatusCode)
                {
                    continue;
                }

                using var doc = System.Text.Json.JsonDocument.Parse(await statusResp.Content.ReadAsStringAsync());
                var root = doc.RootElement;
                var loading = root.TryGetProperty("loading", out var l) && l.GetBoolean();
                var loaded = root.TryGetProperty("loaded", out var ld) && ld.GetBoolean();
                var error = root.TryGetProperty("error", out var e) && e.ValueKind == System.Text.Json.JsonValueKind.String
                    ? e.GetString()
                    : null;
                if (root.TryGetProperty("phase", out var ph) && ph.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    _loadPhase = ph.GetString();
                }

                if (root.TryGetProperty("progress_pct", out var pp) && pp.TryGetInt32(out var pct))
                {
                    _loadPct = pct;
                }

                if (root.TryGetProperty("elapsed_ms", out var em) && em.TryGetInt64(out var ms))
                {
                    _loadElapsedSec = ms / 1000.0;
                }

                Guid? loadedId = null;
                if (root.TryGetProperty("model_id", out var mid) && mid.ValueKind == System.Text.Json.JsonValueKind.String
                    && Guid.TryParse(mid.GetString(), out var gid))
                {
                    loadedId = gid;
                }

                if (!string.IsNullOrWhiteSpace(error) && !loading)
                {
                    _msg = $"Load failed: {error}";
                    return;
                }

                if (!loading && loaded && (loadedId == model.Id || Engine.LoadedModelId == model.Id || IsLoadedModel(model)))
                {
                    _msg = $"Loaded {label}.";
                    await ReloadAsync();
                    return;
                }

                if (!loading && !loaded)
                {
                    _msg = string.IsNullOrWhiteSpace(error)
                        ? $"Load failed for {label}."
                        : $"Load failed: {error}";
                    return;
                }

                var phase = string.IsNullOrEmpty(_loadPhase) ? "working" : _loadPhase;
                _msg = $"Loading {label} — {phase} {(_loadPct > 0 ? _loadPct + "%" : "")} ({_loadElapsedSec:0}s).";
                await InvokeAsync(StateHasChanged);
            }

            _msg = $"Load timed out for {label}. Check Diagnostics / logs.";
        }
        catch (Exception ex)
        {
            _msg = $"Load failed: {ex.Message}";
        }
        finally
        {
            _loadingId = null;
            _busy = false;
        }
    }

    private async Task UnloadAsync()
    {
        _busy = true;
        _msg = null;
        try
        {
            await Engine.UnloadAsync();
            _msg = "Model unloaded.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task QuantizeAsync()
    {
        _busy = true;
        _msg = null;
        try
        {
            object payload;
            if (Guid.TryParse(_quantizeModelId, out var mid) && mid != Guid.Empty)
            {
                payload = new { model_id = mid, bits = _quantizeBits };
            }
            else if (!string.IsNullOrWhiteSpace(_quantizePath))
            {
                payload = new { source_path = _quantizePath.Trim(), bits = _quantizeBits };
            }
            else
            {
                _msg = "Select a model or enter a source path.";
                return;
            }

            var client = CreateApi();
            var resp = await client.PostAsJsonAsync("/api/v1/models/quantize", payload);
            var body = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _msg = body;
                return;
            }

            _msg = $"Quantize started. {body} — watch Jobs.";
            Tab = "mine";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ImportAsync()
    {
        if (string.IsNullOrWhiteSpace(_importPath))
        {
            _msg = "Path required.";
            return;
        }

        try
        {
            await Inventory.EnsureRecordAsync(
                _importPath.Trim(),
                string.IsNullOrWhiteSpace(_importAlias) ? null : _importAlias.Trim());
            _msg = "Imported.";
            await ReloadAsync();
            Tab = "mine";
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
    }
}
