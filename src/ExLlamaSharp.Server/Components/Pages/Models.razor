@page "/models"
@inject AppDbContext Db
@inject EngineHostService Engine
@inject ModelInventoryService Inventory
@inject HuggingFaceCatalogService HuggingFace
@inject ModelJobsService Jobs
@inject GpuInfoService GpuInfo
@inject SettingsService Settings
@inject VramFitService VramFit
@inject IHttpClientFactory HttpClientFactory
@inject NavigationManager Nav
@inject IJSRuntime Js
@using Microsoft.EntityFrameworkCore
@using ExLlamaSharp.Server.Services.Ui
@using System.Net.Http.Json

<PageTitle>Models — ExLlamaSharp</PageTitle>

<PageHeader Title="Models" Subtitle="Library, installed models, import, and quantize.">
    <Actions>
        @if (Tab == "mine")
        {
            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="ReloadAsync">
                <i class="fas fa-sync-alt mr-1"></i> Refresh
            </button>
        }
        <a class="btn btn-sm btn-outline-primary" href="/jobs"><i class="fas fa-tasks"></i> Jobs</a>
    </Actions>
</PageHeader>

<ModelStatusBanner />

@if (_gpuChips.Count > 0)
{
    <div class="exl-gpu-bar mb-3" title="@_gpuCaption">
        <span class="exl-gpu-bar-label"><i class="fas fa-microchip mr-1"></i> GPU</span>
        <div class="kx-chip-row mb-0">
            @foreach (var chip in _gpuChips)
            {
                <span class="kx-chip">@chip</span>
            }
        </div>
    </div>
}
else if (!string.IsNullOrWhiteSpace(_gpuCaption))
{
    <div class="alert alert-light border mb-3 py-2"><i class="fas fa-info-circle mr-1 text-muted"></i> @_gpuCaption</div>
}

<PageTabs>
    <button class="tab-btn @(Tab == "library" ? "active" : "")" @onclick='() => Tab = "library"'>Library</button>
    <button class="tab-btn @(Tab == "mine" ? "active" : "")" @onclick='() => Tab = "mine"'>My Models</button>
    <button class="tab-btn @(Tab == "import" ? "active" : "")" @onclick='() => Tab = "import"'>Import</button>
    <button class="tab-btn @(Tab == "quantize" ? "active" : "")" @onclick='() => Tab = "quantize"'>Quantize</button>
</PageTabs>

@if (Tab == "library")
{
    <div class="card card-outline card-secondary mb-3">
        <div class="card-header"><h3 class="card-title"><i class="fas fa-cloud-download-alt mr-2"></i>Search Hugging Face</h3></div>
        <div class="card-body">
            <div class="d-flex flex-wrap align-items-end">
                <div class="flex-grow-1 mr-2 mb-2 mb-md-0">
                    <label class="form-label">Query</label>
                    <input class="form-control" @bind="_hfQuery" @bind:event="oninput" placeholder="exl3, llama, qwen…" @onkeydown="OnSearchKey" />
                </div>
                <button class="btn btn-sm btn-primary mb-2 mb-md-0" disabled="@_searching" @onclick="SearchHuggingFaceAsync">
                    <i class="fas fa-search"></i> @(_searching ? "Searching…" : "Search")
                </button>
            </div>
            <p class="form-text mb-0 mt-2">
                Prefer standalone <code>exl3</code> chat/VLM models. Drafts (DFlash), GGUF, and incomplete repos are hidden.
            </p>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert alert-info mb-3"><i class="fas fa-info-circle mr-1"></i> @_msg</div>
    }
    <div class="card card-outline card-primary card-table">
        <div class="card-header"><h3 class="card-title"><i class="fas fa-search mr-2"></i>Library results</h3></div>
        <div class="card-body p-0">
            <div class="kx-table-wrap">
            <table class="table-clean">
                <thead>
                    <tr><th>Name</th><th>Repo</th><th class="col-narrow">Params</th><th class="col-narrow">Size</th><th class="col-vram">VRAM</th><th class="col-actions">Actions</th></tr>
                </thead>
                <tbody>
                    @if (_hfHits.Count == 0 && !_searching)
                    {
                        <tr><td colspan="6" class="text-muted text-center py-4">No Hugging Face results. Try “exl3” or check your network / HF token.</td></tr>
                    }
                    @foreach (var m in _hfHits)
                    {
                        var fit = VramFit.Evaluate(m.SizeBytes, _gpus, _gpuUtil, _gpuSplitGb, _maxBatchedTokens);
                        <tr>
                            <td>@m.DisplayName</td>
                            <td><code class="kx-path-truncate" title="@m.RepoId">@m.RepoId</code></td>
                            <td>@(m.ParameterLabel ?? "—")</td>
                            <td>@(m.SizeBytes is null ? "…" : m.SizeBytes > 0 ? HuggingFaceCatalogService.FormatBytes(m.SizeBytes.Value) : "—")</td>
                            <td class="col-vram"><span class="badge-status @fit.BadgeClass" title="@fit.Detail">@fit.Label</span></td>
                            <td class="col-actions">
                                <button class="btn btn-sm btn-primary exl-btn-fixed" disabled="@_pulling" @onclick="() => PullAsync(m.RepoId, m.DisplayName)">
                                    <i class="fas fa-download"></i> Download
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
}
else if (Tab == "mine")
{
    @if (Engine.IsLoaded && Engine.LoadedModelPath is { } loadedPath)
    {
        <div class="exl-status-banner is-ok mb-3">
            <div><i class="fas fa-check-circle mr-1"></i> Loaded: <code>@Path.GetFileName(loadedPath.TrimEnd(Path.DirectorySeparatorChar))</code></div>
            <button class="btn btn-sm btn-outline-danger" disabled="@_busy" @onclick="UnloadAsync"><i class="fas fa-eject"></i> Unload</button>
        </div>
    }
    @if (_loadingId is not null || _busy)
    {
        <div class="exl-load-strip">
            <button class="btn btn-sm btn-outline-danger" disabled="@(!_busy && _loadingId is null)" @onclick="CancelLoadUiAsync"><i class="fas fa-times"></i> Cancel</button>
            @if (_loadingId is not null)
            {
                <div class="progress-thin"><span style="width:@(_loadPct.ToString("0"))%"></span></div>
                <div class="form-text mb-0">
                    @(string.IsNullOrEmpty(_loadPhase) ? "Loading" : _loadPhase)
                    @if (_loadPct > 0) { <text> · @_loadPct%</text> }
                    @if (_loadElapsedSec > 0) { <text> · @_loadElapsedSec.ToString("0")s</text> }
                </div>
            }
        </div>
    }

    <div class="card card-outline card-primary card-table">
        <div class="card-header"><h3 class="card-title"><i class="fas fa-cube mr-2"></i>My models</h3></div>
        <div class="card-body p-0">
            <div class="kx-table-wrap">
            <table class="table-clean table-dense">
                <thead>
                    <tr><th>Alias</th><th class="kx-col-folder">Folder</th><th class="col-narrow">Size</th><th class="col-narrow">Quant</th><th class="col-vram">VRAM</th><th class="col-status">Status</th><th class="col-actions">Actions</th></tr>
                </thead>
                <tbody>
                    @if (_mine.Count == 0)
                    {
                        <tr>
                            <td colspan="7" class="p-0 border-0">
                                <ExlEmpty Icon="fas fa-cube" Title="No local models" Message="Download from Library or import a folder." />
                            </td>
                        </tr>
                    }
                    @foreach (var m in _mine)
                    {
                        var fit = VramFit.EvaluateGb(m.SizeGb, _gpus, _gpuUtil, _gpuSplitGb, _maxBatchedTokens);
                        var isLoaded = IsLoadedModel(m);
                        var isLoading = _loadingId == m.Id;
                        var folderName = Path.GetFileName(m.Path.TrimEnd(Path.DirectorySeparatorChar));
                        <tr class="@(isLoaded ? "table-row-active" : null)">
                            <td>
                                @if (_editingAliasId == m.Id)
                                {
                                    <div class="d-flex flex-wrap gap-1 align-items-center">
                                        <input class="form-control form-control-sm" style="min-width:8rem" @bind="_aliasDraft" />
                                        <button type="button" class="btn btn-sm btn-primary" disabled="@_busy" @onclick="() => SaveAliasAsync(m)">Save</button>
                                        <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="CancelEdit">Cancel</button>
                                    </div>
                                }
                                else
                                {
                                    <div class="fw-semibold">@(string.IsNullOrWhiteSpace(m.Alias) ? folderName : m.Alias)</div>
                                }
                            </td>
                            <td class="kx-col-folder"><code title="@m.Path">@folderName</code></td>
                            <td class="text-nowrap">@FormatSizeGb(m.SizeGb)</td>
                            <td>@(m.QuantMode ?? "—")</td>
                            <td class="col-vram"><span class="badge-status @fit.BadgeClass" title="@fit.Detail">@fit.Label</span></td>
                            <td class="col-status">
                                @if (isLoading)
                                {
                                    <span class="badge-status badge-warn">
                                        @(string.IsNullOrEmpty(_loadPhase) ? "Loading…" : $"{_loadPhase} {_loadPct}%")
                                    </span>
                                }
                                else if (isLoaded)
                                {
                                    <span class="badge-status badge-ok">Loaded</span>
                                }
                                else if (!Directory.Exists(m.Path))
                                {
                                    <span class="badge-status badge-err" title="@m.Path">Missing</span>
                                }
                                else if (!HasWeights(m.Path))
                                {
                                    <span class="badge-status badge-warn" title="No .safetensors weights found">Incomplete</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-muted">Ready</span>
                                }
                            </td>
                            <td class="col-actions">
                                <div class="exl-actions-cell">
                                    @if (isLoaded)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger exl-btn-fixed" disabled="@_busy" @onclick="UnloadAsync">Unload</button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-primary exl-btn-fixed" disabled="@(_busy || isLoading)" @onclick="() => BeginLoadModelAsync(m)">
                                            @(isLoading ? "…" : "Load")
                                        </button>
                                    }
                                    <details class="kx-menu">
                                        <summary class="kx-menu-toggle" title="More actions"><i class="fas fa-ellipsis-v"></i></summary>
                                        <div class="kx-menu-panel">
                                            <button type="button" class="kx-menu-item" disabled="@_busy" @onclick="() => BeginEditAlias(m)">Alias</button>
                                            <button type="button" class="kx-menu-item" disabled="@_busy" @onclick="() => RenameFolderAsync(m)">Rename</button>
                                            <button type="button" class="kx-menu-item" disabled="@_busy" @onclick="() => DeleteModelAsync(m, deleteFiles: false)">Remove</button>
                                            <button type="button" class="kx-menu-item is-danger" disabled="@_busy" @onclick="() => DeleteModelAsync(m, deleteFiles: true)">Delete files</button>
                                        </div>
                                    </details>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            </div>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_msg))
    {
        <div class="alert alert-info mt-3"><i class="fas fa-info-circle mr-1"></i> @_msg</div>
    }

    @if (_loadPickerModel is not null)
    {
        <div class="exl-modal-backdrop" @onclick="CancelLoadPicker">
            <div class="card card-outline card-primary exl-load-dialog" @onclick:stopPropagation="true">
                <div class="card-header">
                    <h3 class="card-title mb-0"><i class="fas fa-sliders-h mr-2"></i>Load model</h3>
                    <button type="button" class="close" @onclick="CancelLoadPicker"><span>&times;</span></button>
                </div>
                <div class="card-body">
                    <p class="text-muted mb-3">
                        @(string.IsNullOrWhiteSpace(_loadPickerModel.Alias)
                            ? Path.GetFileName(_loadPickerModel.Path.TrimEnd(Path.DirectorySeparatorChar))
                            : _loadPickerModel.Alias)
                        — choose a VRAM / context profile (or keep your Settings).
                    </p>
                    @if (_loadProfilesLoading)
                    {
                        <p class="text-muted mb-0">Calculating profiles…</p>
                    }
                    else if (!string.IsNullOrEmpty(_loadProfilesError))
                    {
                        <div class="alert alert-danger mb-3">@_loadProfilesError</div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="CancelLoadPicker">Close</button>
                    }
                    else
                    {
                        <div class="exl-profile-list mb-3">
                            @foreach (var p in _loadProfiles)
                            {
                                <label class="exl-profile-option @(_selectedLoadProfile == p.Id ? "active" : null) @(p.Available ? null : "disabled")">
                                    <input type="radio" name="load-profile" disabled="@(!p.Available)"
                                           checked="@(_selectedLoadProfile == p.Id)"
                                           @onchange="() => _selectedLoadProfile = p.Id" />
                                    <span class="exl-profile-body">
                                        <span class="d-flex justify-content-between gap-2 align-items-center">
                                            <strong>@p.Label</strong>
                                            <span class="badge-status @p.BadgeClass">@(p.Available ? p.KindLabel : "Unavailable")</span>
                                        </span>
                                        <span class="form-text mb-0">@p.Summary</span>
                                    </span>
                                </label>
                            }
                            @if (_customProfile is not null)
                            {
                                <label class="exl-profile-option @(_selectedLoadProfile == "custom" ? "active" : null)">
                                    <input type="radio" name="load-profile"
                                           checked="@(_selectedLoadProfile == "custom")"
                                           @onchange='() => _selectedLoadProfile = "custom"' />
                                    <span class="exl-profile-body">
                                        <span class="d-flex justify-content-between gap-2 align-items-center">
                                            <strong>@_customProfile.Label</strong>
                                            <span class="badge-status badge-muted">Settings</span>
                                        </span>
                                        <span class="form-text mb-0">@_customProfile.Summary</span>
                                    </span>
                                </label>
                            }
                        </div>
                        <div class="exl-btn-row justify-content-end">
                            <button class="btn btn-sm btn-outline-secondary" disabled="@_busy" @onclick="CancelLoadPicker">Cancel</button>
                            <button class="btn btn-sm btn-primary" disabled="@(_busy || string.IsNullOrEmpty(_selectedLoadProfile))"
                                    @onclick="ConfirmLoadWithProfileAsync">
                                <i class="fas fa-play"></i> Load with profile
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
}
else if (Tab == "quantize")
{
    <div class="card card-outline card-primary">
        <div class="card-header"><h3 class="card-title"><i class="fas fa-compress mr-2"></i>Quantize to EXL3</h3></div>
        <div class="card-body">
            <div class="form-grid">
                <div>
                    <label class="form-label">Source model</label>
                    <select class="form-select" @bind="_quantizeModelId">
                        <option value="">— select installed —</option>
                        @foreach (var m in _mine)
                        {
                            <option value="@m.Id">@(m.Alias ?? m.Path)</option>
                        }
                    </select>
                </div>
                <div>
                    <label class="form-label">Or source path</label>
                    <input class="form-control" @bind="_quantizePath" placeholder="D:\models\fp16-model" />
                </div>
                <div>
                    <label class="form-label">Bits</label>
                    <input type="number" step="0.25" class="form-control" @bind="_quantizeBits" />
                </div>
                <button class="btn btn-sm btn-primary" disabled="@_busy" @onclick="QuantizeAsync"><i class="fas fa-compress"></i> Start quantize</button>
            </div>
            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="alert alert-info mt-3"><i class="fas fa-info-circle mr-1"></i> @_msg</div>
            }
        </div>
    </div>
}
else
{
    <div class="card card-outline card-primary">
        <div class="card-header"><h3 class="card-title"><i class="fas fa-folder-open mr-2"></i>Import local folder</h3></div>
        <div class="card-body">
            <div class="form-grid">
                <div>
                    <label class="form-label">Model path</label>
                    <input class="form-control" @bind="_importPath" placeholder="D:\models\my-exl2" />
                </div>
                <div>
                    <label class="form-label">Alias</label>
                    <input class="form-control" @bind="_importAlias" />
                </div>
                <button class="btn btn-sm btn-primary" @onclick="ImportAsync"><i class="fas fa-file-import"></i> Import</button>
            </div>
            @if (!string.IsNullOrEmpty(_msg))
            {
                <div class="alert alert-info mt-3"><i class="fas fa-info-circle mr-1"></i> @_msg</div>
            }
        </div>
    </div>
}

@code {
    private string Tab = "library";
    private List<HuggingFaceModelHit> _hfHits = [];
    private List<ModelRecord> _mine = [];
    private string _importPath = "";
    private string _importAlias = "";
    private string _hfQuery = "exl3";
    private string? _msg;
    private bool _searching;
    private bool _pulling;
    private bool _busy;
    private Guid? _loadingId;
    private string? _loadPhase;
    private int _loadPct;
    private double _loadElapsedSec;
    private Guid? _editingAliasId;
    private string _aliasDraft = "";
    private string _quantizeModelId = "";
    private string _quantizePath = "";
    private double _quantizeBits = 4.0;
    private IReadOnlyList<GpuSnapshot> _gpus = [];
    private double _gpuUtil = VramFitService.DefaultGpuUtilization;
    private string? _gpuSplitGb;
    private string? _cudaVisible;
    private int _maxBatchedTokens = VramFitService.DefaultContextTokens;
    private string _gpuCaption = "Reading GPU VRAM…";
    private List<string> _gpuChips = [];
    private ModelRecord? _loadPickerModel;
    private bool _loadProfilesLoading;
    private string? _loadProfilesError;
    private string _selectedLoadProfile = VramFitService.ProfileNormal;
    private List<LoadProfileUi> _loadProfiles = [];
    private LoadProfileUi? _customProfile;

    private sealed class LoadProfileUi
    {
        public string Id { get; init; } = "";
        public string Label { get; init; } = "";
        public string Summary { get; init; } = "";
        public string BadgeClass { get; init; } = "badge-muted";
        public string KindLabel { get; init; } = "";
        public bool Available { get; init; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadGpuAsync();
        await ReloadAsync();
        await SearchHuggingFaceAsync();
    }

    private HttpClient CreateApi()
    {
        var client = HttpClientFactory.CreateClient("local-api");
        client.BaseAddress ??= new Uri(Nav.BaseUri);
        return client;
    }

    private static string FormatSizeGb(double gb)
    {
        if (gb < 0.05)
        {
            return "—";
        }

        return gb < 10 ? $"{gb:0.00} GB" : $"{gb:0.0} GB";
    }

    private static bool HasWeights(string path)
    {
        try
        {
            return Directory.Exists(path)
                && Directory.EnumerateFiles(path, "*.safetensors", SearchOption.AllDirectories).Any();
        }
        catch
        {
            return false;
        }
    }

    private bool IsLoadedModel(ModelRecord m)
    {
        if (!Engine.IsLoaded || string.IsNullOrWhiteSpace(Engine.LoadedModelPath))
        {
            return false;
        }

        if (Engine.LoadedModelId == m.Id)
        {
            return true;
        }

        try
        {
            return string.Equals(
                Path.GetFullPath(Engine.LoadedModelPath.TrimEnd(Path.DirectorySeparatorChar)),
                Path.GetFullPath(m.Path.TrimEnd(Path.DirectorySeparatorChar)),
                StringComparison.OrdinalIgnoreCase);
        }
        catch
        {
            return false;
        }
    }

    private async Task LoadGpuAsync()
    {
        _gpuSplitGb = null;
        _cudaVisible = null;
        try
        {
            var settings = await Settings.GetAsync();
            _gpuUtil = settings.GpuMemoryUtilization;
            _gpuSplitGb = settings.GpuSplitGb;
            _cudaVisible = settings.CudaVisibleDevices;
            _maxBatchedTokens = settings.MaxBatchedTokens;
        }
        catch
        {
            _gpuUtil = VramFitService.DefaultGpuUtilization;
        }

        try
        {
            var all = await GpuInfo.GetGpusAsync();
            _gpus = GpuInfoService.FilterVisible(all, _cudaVisible);
        }
        catch
        {
            _gpus = [];
        }

        _gpuCaption = VramFitService.FormatGpuCaption(_gpus, _gpuUtil, _cudaVisible, _gpuSplitGb);
        _gpuChips = [];
        if (_gpus.Count > 0)
        {
            _gpuChips.Add(_gpus.Count == 1 ? "1 GPU" : $"{_gpus.Count} GPUs");
            foreach (var g in _gpus)
            {
                var gb = g.MemoryTotalMb / 1024d;
                var shortName = g.Name.Replace("NVIDIA GeForce ", "", StringComparison.OrdinalIgnoreCase)
                    .Replace("NVIDIA ", "", StringComparison.OrdinalIgnoreCase);
                _gpuChips.Add($"{shortName} {gb:0.#} GB");
            }

            var usable = _gpus.Sum(g => g.MemoryTotalMb) / 1024d * _gpuUtil;
            _gpuChips.Add($"{usable:0.#} GB usable");
        }
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchHuggingFaceAsync();
        }
    }

    private async Task SearchHuggingFaceAsync()
    {
        _searching = true;
        _msg = null;
        try
        {
            _hfHits = HuggingFaceCatalogService.FilterLoadableHits(await HuggingFace.SearchAsync(_hfQuery)).ToList();
            if (_hfHits.Count == 0)
            {
                _msg = "No loadable EXL3 models for that search (drafts / incomplete repos are filtered out).";
            }
            else
            {
                _ = EnrichLibraryAsync();
            }
        }
        catch (Exception ex)
        {
            _hfHits = [];
            _msg = ex.Message;
        }
        finally
        {
            _searching = false;
        }
    }

    private async Task EnrichLibraryAsync()
    {
        var snapshot = _hfHits;
        try
        {
            await HuggingFace.EnrichHitsAsync(snapshot);
            _hfHits = HuggingFaceCatalogService.FilterLoadableHits(snapshot).ToList();
            if (_hfHits.Count == 0)
            {
                _msg = "No loadable EXL3 models after checking weights/tokenizer (incomplete Hub repos were removed).";
            }
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // size is optional; params from the repo name already show
        }
    }

    private async Task ReloadAsync()
    {
        try
        {
            await Inventory.SyncFromDiskAsync();
            foreach (var e in Db.ChangeTracker.Entries().ToList())
            {
                e.State = EntityState.Detached;
            }

            _mine = await Db.Models.AsNoTracking().OrderByDescending(x => x.CreatedAt).Take(100).ToListAsync();
        }
        catch
        {
            _mine = [];
        }
    }

    private async Task RefreshMineAsync()
    {
        _busy = true;
        _msg = null;
        try
        {
            await Inventory.RefreshAllSizesAsync();
            await ReloadAsync();
            _msg = "Sizes refreshed from disk.";
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CancelLoadUiAsync()
    {
        try
        {
            var client = CreateApi();
            await client.PostAsync("/api/v1/models/load-cancel", null);
            _msg = "Load cancelled.";
            _loadingId = null;
            _busy = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
    }

    private async Task PullAsync(string repoId, string displayName)
    {
        var probe = new HuggingFaceModelHit
        {
            RepoId = repoId,
            DisplayName = displayName,
            Tags = repoId,
        };
        if (!HuggingFaceCatalogService.IsStandaloneExl3Candidate(probe))
        {
            _msg = $"Skipped {displayName}: not a standalone EXL3 chat/VLM model (drafts like DFlash are not supported).";
            return;
        }

        _pulling = true;
        _msg = $"Downloading {displayName} from Hugging Face… this can take several minutes.";
        try
        {
            var job = await Jobs.EnqueuePullAsync(repoId);
            _msg = $"Download started ({displayName}). Job {job.JobId:N} — watch Jobs, then My Models.";
            Tab = "mine";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _pulling = false;
        }
    }

