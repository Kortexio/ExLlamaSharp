    private async Task DeleteModelAsync(ModelRecord model, bool deleteFiles)
    {
        var label = string.IsNullOrWhiteSpace(model.Alias)
            ? Path.GetFileName(model.Path.TrimEnd(Path.DirectorySeparatorChar))
            : model.Alias;
        var confirm = deleteFiles
            ? $"Delete '{label}' from the library AND erase files on disk?\n{model.Path}"
            : $"Remove '{label}' from My Models? (files stay on disk)";
        if (!await Js.InvokeAsync<bool>("confirm", confirm))
        {
            return;
        }

        _busy = true;
        _msg = null;
        try
        {
            var client = CreateApi();
            var url = $"/api/v1/models/{model.Id}?delete_files={(deleteFiles ? "true" : "false")}";
            var resp = await client.DeleteAsync(url);
            var body = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _msg = body;
                return;
            }

            _msg = deleteFiles ? $"Deleted {label} and files." : $"Removed {label} from library.";
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _msg = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task BeginLoadModelAsync(ModelRecord model)
    {
        var label = string.IsNullOrWhiteSpace(model.Alias)
            ? Path.GetFileName(model.Path.TrimEnd(Path.DirectorySeparatorChar))
            : model.Alias;

        if (!Directory.Exists(model.Path))
        {
            _msg = $"Load failed: folder missing — {model.Path}";
            return;
        }

        if (!HasWeights(model.Path))
        {
            _msg = $"Load failed: incomplete model (no .safetensors) — {label}";
            return;
        }

        _loadPickerModel = model;
        _loadProfilesLoading = true;
        _loadProfilesError = null;
        _loadProfiles = [];
        _customProfile = null;
        _selectedLoadProfile = VramFitService.NormalizeLoadProfile(model.LastLoadProfile);
        await InvokeAsync(StateHasChanged);

        try
        {
            var client = CreateApi();
            var resp = await client.GetAsync($"/api/v1/models/{model.Id}/load-profiles");
            var body = await resp.Content.ReadAsStringAsync();
            if (!resp.IsSuccessStatusCode)
            {
                _loadProfilesError = $"Could not load profiles: {body}";
                return;
            }

            using var doc = System.Text.Json.JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.TryGetProperty("selected_profile", out var sel) && sel.ValueKind == System.Text.Json.JsonValueKind.String)
            {
                _selectedLoadProfile = VramFitService.NormalizeLoadProfile(sel.GetString());
            }

            _loadProfiles = [];
            if (root.TryGetProperty("profiles", out var profiles) && profiles.ValueKind == System.Text.Json.JsonValueKind.Array)
            {
                foreach (var p in profiles.EnumerateArray())
                {
                    _loadProfiles.Add(new LoadProfileUi
                    {
                        Id = p.TryGetProperty("id", out var pid) ? pid.GetString() ?? "" : "",
                        Label = p.TryGetProperty("label", out var pl) ? pl.GetString() ?? "" : "",
                        Summary = p.TryGetProperty("summary", out var ps) ? ps.GetString() ?? "" : "",
                        BadgeClass = p.TryGetProperty("badge_class", out var pb) ? pb.GetString() ?? "badge-muted" : "badge-muted",
                        KindLabel = p.TryGetProperty("kind", out var pk) ? Capitalize(pk.GetString()) : "",
                        Available = !p.TryGetProperty("available", out var pa) || pa.GetBoolean(),
                    });
                }
            }

            if (root.TryGetProperty("custom", out var custom) && custom.ValueKind == System.Text.Json.JsonValueKind.Object)
            {
                _customProfile = new LoadProfileUi
                {
                    Id = VramFitService.ProfileCustom,
                    Label = custom.TryGetProperty("label", out var cl) ? cl.GetString() ?? "Personalizado" : "Personalizado",
                    Summary = custom.TryGetProperty("summary", out var cs) ? cs.GetString() ?? "" : "",
                    BadgeClass = "badge-muted",
                    KindLabel = "Settings",
                    Available = true,
                };
            }

            if (_selectedLoadProfile != VramFitService.ProfileCustom
                && !_loadProfiles.Any(p => p.Id == _selectedLoadProfile && p.Available))
            {
                _selectedLoadProfile = _loadProfiles.FirstOrDefault(p => p.Available)?.Id
                    ?? VramFitService.ProfileCustom;
            }
        }
        catch (Exception ex)
        {
            _loadProfilesError = ex.Message;
        }
        finally
        {
            _loadProfilesLoading = false;
        }
    }

    private void CancelLoadPicker()
    {
        _loadPickerModel = null;
        _loadProfilesError = null;
        _loadProfilesLoading = false;
    }

    private async Task ConfirmLoadWithProfileAsync()
    {
        if (_loadPickerModel is null)
        {
            return;
        }

        var model = _loadPickerModel;
        var profile = _selectedLoadProfile;
        CancelLoadPicker();
        await LoadModel(model, profile);
    }

    private static string Capitalize(string? value)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return "";
        }

        return char.ToUpperInvariant(value[0]) + value[1..];
    }

    private async Task LoadModel(ModelRecord model, string? profile = null)
    {
        var label = string.IsNullOrWhiteSpace(model.Alias)
            ? Path.GetFileName(model.Path.TrimEnd(Path.DirectorySeparatorChar))
            : model.Alias;

        if (!Directory.Exists(model.Path))
        {
            _msg = $"Load failed: folder missing — {model.Path}";
            return;
        }

        if (!HasWeights(model.Path))
        {
            _msg = $"Load failed: incomplete model (no .safetensors) — {label}";
            return;
        }

        _busy = true;
        _loadingId = model.Id;
        _loadPhase = "starting";
        _loadPct = 1;
        _loadElapsedSec = 0;
        var profileKey = VramFitService.NormalizeLoadProfile(profile);
        _msg = $"Loading {label} ({profileKey})… this can take 1–3 minutes. UI stays responsive.";
        await InvokeAsync(StateHasChanged);
        try
        {
            var client = CreateApi();
            var resp = await client.PostAsJsonAsync("/api/v1/models/load", new
            {
                model_id = model.Id,
                path = model.Path,
                background = true,
                profile = profileKey,
            });
            var body = await resp.Content.ReadAsStringAsync();
            if (resp.StatusCode == System.Net.HttpStatusCode.Conflict)
            {
                _msg = "Another model is already loading. Wait for it to finish.";
                return;
            }

            if (!resp.IsSuccessStatusCode)
            {
                _msg = $"Load failed: {body}";
                return;
            }

            // Poll status so the Blazor circuit is not blocked inside Engine.LoadAsync.
            var deadline = DateTime.UtcNow.AddMinutes(10);
            while (DateTime.UtcNow < deadline)
            {
                await Task.Delay(1500);
                var statusResp = await client.GetAsync("/api/v1/models/load-status");
                if (!statusResp.IsSuccessStatusCode)
                {
                    continue;
                }

                using var doc = System.Text.Json.JsonDocument.Parse(await statusResp.Content.ReadAsStringAsync());
                var root = doc.RootElement;
                var loading = root.TryGetProperty("loading", out var l) && l.GetBoolean();
                var loaded = root.TryGetProperty("loaded", out var ld) && ld.GetBoolean();
                var error = root.TryGetProperty("error", out var e) && e.ValueKind == System.Text.Json.JsonValueKind.String
                    ? e.GetString()
                    : null;
                if (root.TryGetProperty("phase", out var ph) && ph.ValueKind == System.Text.Json.JsonValueKind.String)
                {
                    _loadPhase = ph.GetString();
                }

                if (root.TryGetProperty("progress_pct", out var pp) && pp.TryGetInt32(out var pct))
                {
                    _loadPct = pct;
                }

                if (root.TryGetProperty("elapsed_ms", out var em) && em.TryGetInt64(out var ms))
                {
                    _loadElapsedSec = ms / 1000.0;
                }

                Guid? loadedId = null;
                if (root.TryGetProperty("model_id", out var mid) && mid.ValueKind == System.Text.Json.JsonValueKind.String
                    && Guid.TryParse(mid.GetString(), out var gid))
                {
                    loadedId = gid;
                }

                if (!string.IsNullOrWhiteSpace(error) && !loading)
                {
                    _msg = $"Load failed: {error}";
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (!loading && loaded && (loadedId == model.Id || Engine.LoadedModelId == model.Id || IsLoadedModel(model)))
                {
                    _msg = $"Loaded {label}.";
                    await ReloadAsync();
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (!loading && !loaded)
                {
                    _msg = string.IsNullOrWhiteSpace(error)
                        ? $"Load failed for {label}."
                        : $"Load failed: {error}";
                    return;
                }

                var phase = string.IsNullOrEmpty(_loadPhase) ? "working" : _loadPhase;
                _msg = $"Loading {label} — {phase} {(_loadPct > 0 ? _loadPct + "%" : "")} ({_loadElapsedSec:0}s).";
                await InvokeAsync(StateHasChanged);
            }

            _msg = $"Load timed out for {label}. Check Diagnostics / logs.";
        }
        catch (Exception ex)
        {
            _msg = $"Load failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
            _loadingId = null;
            _loadPhase = null;
            _loadPct = 0;
            _loadElapsedSec = 0;
            await InvokeAsync(StateHasChanged);
        }
    }

