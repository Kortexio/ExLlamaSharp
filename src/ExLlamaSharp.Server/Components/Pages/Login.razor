@page "/login"
@layout Layout.MainLayout
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject AdminUiSession Session
@inject KeyCacheService KeyCache
@using System.Security.Cryptography
@using Microsoft.EntityFrameworkCore
@using ExLlamaSharp.Server.Auth
@using ExLlamaSharp.Server.Services.Ui

<PageTitle>Login — ExLlamaSharp</PageTitle>

<div class="login-box">
    <div class="login-logo mb-4">
        <a href="/"><b>ExLlama</b>Sharp</a>
    </div>
    <div class="card">
        <div class="card-body login-card-body p-4">
            <p class="login-box-msg mb-3">Sign in to the admin console</p>
            <div class="input-group mb-3">
                <input class="form-control" @bind="_user" autocomplete="username" placeholder="Username" />
                <div class="input-group-append">
                    <div class="input-group-text"><span class="fas fa-user"></span></div>
                </div>
            </div>
            <div class="input-group mb-3">
                <input type="password" class="form-control" @bind="_pass" autocomplete="current-password" placeholder="Password"
                       @onkeydown="OnKeyDown" />
                <div class="input-group-append">
                    <div class="input-group-text"><span class="fas fa-lock"></span></div>
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="alert alert-danger py-2">@_error</div>
            }
            <button type="button" class="btn btn-primary btn-block btn-lg" @onclick="LoginAsync"><i class="fas fa-sign-in-alt"></i> Sign in</button>
            <p class="mb-0 mt-3 text-muted text-sm">
                Default after fresh install: <code>admin</code> / <code>changeme</code> — change this in Setup or Team.
                First-time? Open <a href="/setup">Setup wizard</a>.
            </p>
        </div>
    </div>
</div>

@code {
    private const string AdminUiKeyName = "admin-ui";
    private string _user = "admin";
    private string _pass = "";
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        if (!await Db.Users.AsNoTracking().AnyAsync())
        {
            Nav.NavigateTo("/setup");
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await LoginAsync();
        }
    }

    private async Task LoginAsync()
    {
        _error = null;
        try
        {
            var candidates = await Db.Users.AsNoTracking()
                .Where(u => u.Username == _user)
                .ToListAsync();
            var found = candidates.FirstOrDefault(u => PasswordHasher.Verify(_pass, u.PasswordHash));
            if (found is null)
            {
                _error = "Invalid username or password.";
                return;
            }

            var prior = await Db.ApiKeys
                .Where(k => k.Name == AdminUiKeyName && k.UserId == found.Id && !k.Revoked)
                .ToListAsync();
            foreach (var k in prior)
            {
                k.Revoked = true;
                KeyCache.Invalidate(k.KeyHash);
            }

            var raw = "sk-" + Convert.ToHexString(RandomNumberGenerator.GetBytes(24)).ToLowerInvariant();
            var hash = ApiKeyHasher.Hash(raw);
            var entity = new ApiKey
            {
                Name = AdminUiKeyName,
                KeyHash = hash,
                KeyPrefix = raw[..Math.Min(8, raw.Length)],
                Scopes = "chat,completions,embeddings,admin",
                Rpm = 600,
                Tpm = 1_000_000,
                Priority = 1,
                CostPerMillionTokens = 0,
                UserId = found.Id,
                TenantId = found.TenantId,
                ExpiresAt = DateTime.UtcNow.AddDays(7),
            };
            Db.ApiKeys.Add(entity);
            await Db.SaveChangesAsync();
            KeyCache.Invalidate(hash);

            Session.ApiKey = raw;
            try
            {
                await Js.InvokeVoidAsync("exLlamaSharpAdmin.openSession", raw);
            }
            catch (JSException)
            {
                try { await Js.InvokeVoidAsync("exLlamaSharpAdmin.setApiKeyCookie", raw); } catch (JSException) { }
            }
            catch (Exception ex)
            {
                _error = "Could not open admin session: " + ex.Message;
                return;
            }

            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
