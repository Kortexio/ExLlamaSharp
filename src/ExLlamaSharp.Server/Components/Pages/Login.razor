@page "/login"
@layout Layout.MainLayout
@inject AppDbContext Db
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject AdminUiSession Session
@inject KeyCacheService KeyCache
@using System.Security.Cryptography
@using Microsoft.EntityFrameworkCore
@using ExLlamaSharp.Server.Auth
@using ExLlamaSharp.Server.Services.Ui

<PageTitle>Login — ExLlamaSharp</PageTitle>

<div class="page-header">
    <h1>Login</h1>
    <p>Sign in to the admin console.</p>
</div>

<div class="card" style="max-width:420px">
    <div class="card-body">
        <div class="form-grid">
            <div>
                <label class="form-label">Username</label>
                <input class="form-control" @bind="_user" autocomplete="username" />
            </div>
            <div>
                <label class="form-label">Password</label>
                <input type="password" class="form-control" @bind="_pass" autocomplete="current-password" />
            </div>
            @if (!string.IsNullOrEmpty(_error))
            {
                <div class="text-danger small">@_error</div>
            }
            <button class="btn btn-primary" @onclick="LoginAsync">Sign in</button>
        </div>
        <p class="text-muted small mt-3 mb-0">Seed credentials: admin / changeme (salted SHA-256 via PasswordHasher; legacy hex still accepted).</p>
    </div>
</div>

@code {
    private const string AdminUiKeyName = "admin-ui";
    private string _user = "admin";
    private string _pass = "";
    private string? _error;

    private async Task LoginAsync()
    {
        _error = null;
        try
        {
            var candidates = await Db.Users.AsNoTracking()
                .Where(u => u.Username == _user)
                .ToListAsync();
            var found = candidates.FirstOrDefault(u => PasswordHasher.Verify(_pass, u.PasswordHash));
            if (found is null)
            {
                _error = "Invalid username or password.";
                return;
            }

            // Revoke prior admin-ui session keys for this user, then mint a fresh plaintext key.
            var prior = await Db.ApiKeys
                .Where(k => k.Name == AdminUiKeyName && k.UserId == found.Id && !k.Revoked)
                .ToListAsync();
            foreach (var k in prior)
            {
                k.Revoked = true;
                KeyCache.Invalidate(k.KeyHash);
            }

            var raw = "sk-" + Convert.ToHexString(RandomNumberGenerator.GetBytes(24)).ToLowerInvariant();
            var hash = ApiKeyHasher.Hash(raw);
            var entity = new ApiKey
            {
                Name = AdminUiKeyName,
                KeyHash = hash,
                KeyPrefix = raw[..Math.Min(8, raw.Length)],
                Scopes = "chat,completions,embeddings,admin",
                Rpm = 600,
                Tpm = 1_000_000,
                Priority = 1,
                CostPerMillionTokens = 0,
                UserId = found.Id,
                TenantId = found.TenantId,
                ExpiresAt = DateTime.UtcNow.AddDays(7),
            };
            Db.ApiKeys.Add(entity);
            await Db.SaveChangesAsync();
            KeyCache.Invalidate(hash);

            Session.ApiKey = raw;
            try
            {
                await Js.InvokeVoidAsync("exLlamaSharpAdmin.setApiKeyCookie", raw);
            }
            catch (JSException)
            {
            }

            Nav.NavigateTo("/", forceLoad: true);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
