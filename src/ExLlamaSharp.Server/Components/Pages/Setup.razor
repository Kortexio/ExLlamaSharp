@page "/setup"
@inject GpuInfoService GpuInfo
@inject SettingsService Settings
@inject OnboardingState Onboarding
@inject AppDbContext Db
@inject NavigationManager Nav
@inject ModelJobsService Jobs
@using Microsoft.EntityFrameworkCore

<PageTitle>Setup — ExLlamaSharp</PageTitle>

<PageHeader Title="Setup wizard" Subtitle="Five steps to get started." />

<div class="wizard-steps">
    @for (var i = 1; i <= 5; i++)
    {
        var step = i;
        <div class="wizard-step @(Step == step ? "active" : Step > step ? "done" : "")">
            @step. @StepLabel(step)
        </div>
    }
</div>

<div class="card card-outline card-primary">
    <div class="card-body">
        @if (Step == 1)
        {
            <h5 class="card-title">Welcome</h5>
            <p class="kx-help-short">Local LLM inference with a simple admin console.</p>
            @if (_gpu is null)
            {
                <p class="text-muted">Detecting GPU?</p>
            }
            else
            {
                <div class="alert-soft mb-3">
                    @if (_gpus.Count > 0)
                    {
                        @foreach (var g in _gpus)
                        {
                            <div><strong>PCI @g.Index · @g.Name</strong> @(g.IsMock ? "(mock)" : "")</div>
                            <div class="text-muted small mb-1">
                                Util @g.UtilizationPct.ToString("0")% ·
                                VRAM @g.MemoryUsedMb.ToString("0") / @g.MemoryTotalMb.ToString("0") MB
                            </div>
                        }
                    }
                    else
                    {
                        <div><strong>@_gpu.Name</strong> @(_gpu.IsMock ? "(mock)" : "")</div>
                        <div class="text-muted small">
                            Util @_gpu.UtilizationPct.ToString("0")% ·
                            VRAM @_gpu.MemoryUsedMb.ToString("0") / @_gpu.MemoryTotalMb.ToString("0") MB
                        </div>
                    }
                </div>
            }
            <button class="btn btn-sm btn-primary" @onclick="Next">Continue <i class="fas fa-arrow-right"></i></button>
        }
        else if (Step == 2)
        {
            <h5 class="card-title">Create admin account</h5>
            <div class="form-grid">
                <div>
                    <label class="form-label">Username</label>
                    <input class="form-control" @bind="_adminUser" />
                </div>
                <div>
                    <label class="form-label">Password</label>
                    <input type="password" class="form-control" @bind="_adminPass" />
                </div>
                @if (!string.IsNullOrEmpty(_error))
                {
                    <div class="text-danger small">@_error</div>
                }
                <div class="exl-btn-row">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Back"><i class="fas fa-arrow-left"></i> Back</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveAdmin">Continue <i class="fas fa-arrow-right"></i></button>
                </div>
            </div>
        }
        else if (Step == 3)
        {
            <h5 class="card-title">Models path</h5>
            <div class="form-grid">
                <div>
                    <label class="form-label">Models folder</label>
                    <input class="form-control" @bind="_modelsPath" placeholder="C:\Models\exllama" />
                </div>
                <div class="exl-btn-row">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Back"><i class="fas fa-arrow-left"></i> Back</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveModelsPath">Continue <i class="fas fa-arrow-right"></i></button>
                </div>
            </div>
        }
        else if (Step == 4)
        {
            <h5 class="card-title">Network</h5>
            <div class="mb-3 p-3 border rounded">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="setupLan"
                           checked="@_lanAccess" @onchange="OnSetupLanChanged" />
                    <label class="form-check-label" for="setupLan">
                        <strong>Allow LAN access</strong>
                    </label>
                </div>
                <p class="form-text mb-0 kx-help-short">
                    API at <code>http://&lt;pc-ip&gt;:@_port/v1</code>. Off = local-only.
                </p>
            </div>
            <div class="form-grid">
                <div>
                    <label class="form-label">Bind address</label>
                    <input class="form-control" @bind="_bind" @bind:after="SyncSetupLanFromBind" />
                </div>
                <div>
                    <label class="form-label">Port</label>
                    <input type="number" class="form-control" @bind="_port" />
                </div>
                <div>
                    <label class="form-label">CORS</label>
                    <input class="form-control" @bind="_cors" />
                </div>
                <div class="exl-btn-row">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="Back"><i class="fas fa-arrow-left"></i> Back</button>
                    <button class="btn btn-sm btn-primary" @onclick="SaveNetwork">Continue <i class="fas fa-arrow-right"></i></button>
                </div>
            </div>
        }
        else
        {
            <h5 class="card-title">Download initial model</h5>
            <p class="form-text kx-help-short">Pick a starter, or skip and import later.</p>
            <div class="form-grid mb-3">
                <div>
                    <label class="form-label">Model repo</label>
                    <input class="form-control" @bind="_starterRepo" placeholder="turboderp/Llama-3.2-1B-Instruct-exl3" />
                </div>
            </div>
            @if (!string.IsNullOrEmpty(_status))
            {
                <div class="alert-soft mb-3">@_status</div>
            }
            <div class="exl-btn-row">
                <button class="btn btn-sm btn-outline-secondary" @onclick="Back"><i class="fas fa-arrow-left"></i> Back</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="SkipFinish">Skip for now</button>
                <button class="btn btn-sm btn-primary" @onclick="QueueDownload"><i class="fas fa-download"></i> Queue download &amp; finish</button>
            </div>
        }
    </div>
</div>

@code {
    private int Step = 1;
    private GpuSnapshot? _gpu;
    private IReadOnlyList<GpuSnapshot> _gpus = [];
    private string _adminUser = "admin";
    private string _adminPass = "";
    private string _modelsPath = "";
    private string _bind = "127.0.0.1";
    private int _port = 14563;
    private string _cors = "http://127.0.0.1:14563,http://localhost:14563";
    private bool _lanAccess;
    private string _starterRepo = "turboderp/Llama-3.2-1B-Instruct-exl3";
    private string? _error;
    private string? _status;

    protected override async Task OnInitializedAsync()
    {
        if (Onboarding.TourCompleted && await Db.Users.AnyAsync())
        {
            Nav.NavigateTo("/login");
            return;
        }

        Step = Math.Clamp(Onboarding.SetupStep is 0 ? 1 : Onboarding.SetupStep, 1, 5);
        try
        {
            _gpus = await GpuInfo.GetGpusAsync();
            _gpu = GpuInfoService.FilterVisible(_gpus, null).FirstOrDefault()
                ?? _gpus.FirstOrDefault();
        }
        catch
        {
            _gpus = [];
            _gpu = null;
        }
        try
        {
            var s = await Settings.GetAsync();
            _modelsPath = string.IsNullOrWhiteSpace(s.ModelsPath)
                ? Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "ExLlamaSharp", "models")
                : s.ModelsPath;
            _bind = s.BindAddress;
            _port = s.Port;
            _cors = s.Cors;
            _lanAccess = ProductionRuntime.IsLanBind(_bind);
        }
        catch
        {
            _modelsPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile), "ExLlamaSharp", "models");
        }
    }

    private static string StepLabel(int s) => s switch
    {
        1 => "Welcome",
        2 => "Admin",
        3 => "Models",
        4 => "Network",
        _ => "Download",
    };

    private void Next()
    {
        Step = Math.Min(5, Step + 1);
        Onboarding.SetupStep = Step;
    }

    private void Back()
    {
        Step = Math.Max(1, Step - 1);
        Onboarding.SetupStep = Step;
    }

    private async Task SaveAdmin()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_adminUser) || string.IsNullOrWhiteSpace(_adminPass))
        {
            _error = "Username and password are required.";
            return;
        }

        try
        {
            var existing = await Db.Users.FirstOrDefaultAsync(u => u.Username == _adminUser);
            if (existing is null)
            {
                Db.Users.Add(new User
                {
                    Username = _adminUser.Trim(),
                    PasswordHash = ExLlamaSharp.Server.Auth.PasswordHasher.Hash(_adminPass),
                    Role = "admin",
                    TenantId = "default",
                });
            }
            else
            {
                existing.PasswordHash = ExLlamaSharp.Server.Auth.PasswordHasher.Hash(_adminPass);
                existing.Role = "admin";
            }

            await Db.SaveChangesAsync();
            Next();
        }
        catch (Exception ex)
        {
            _error = $"Could not save admin (DB may not be ready): {ex.Message}";
        }
    }

    private async Task SaveModelsPath()
    {
        try
        {
            Directory.CreateDirectory(_modelsPath);
            await Settings.UpdateAsync(s => s.ModelsPath = _modelsPath);
        }
        catch
        {
            // proceed with UI even if settings row missing
        }

        Next();
    }

    private async Task SaveNetwork()
    {
        try
        {
            await Settings.UpdateAsync(s =>
            {
                s.BindAddress = _bind;
                s.Port = _port;
                s.Cors = _cors;
            });
            if (ProductionRuntime.IsLanBind(_bind))
            {
                ProductionRuntime.RequestFirewallRule(true, _port);
            }
        }
        catch { }

        Next();
    }

    private void OnSetupLanChanged(ChangeEventArgs e)
    {
        _lanAccess = e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);
        if (_lanAccess)
        {
            _bind = "0.0.0.0";
            _cors = "*";
        }
        else
        {
            _bind = "127.0.0.1";
            _cors = $"http://127.0.0.1:{_port},http://localhost:{_port}";
        }
    }

    private void SyncSetupLanFromBind()
    {
        _lanAccess = ProductionRuntime.IsLanBind(_bind);
    }

    private async Task QueueDownload()
    {
        if (string.IsNullOrWhiteSpace(_starterRepo))
        {
            _status = "Enter a Hugging Face repo id first.";
            return;
        }

        try
        {
            var job = await Jobs.EnqueuePullAsync(_starterRepo.Trim());
            _status = $"Download started for {_starterRepo}. Job {job.JobId:N} ? watch Jobs.";
        }
        catch (Exception ex)
        {
            _status = $"Could not start download: {ex.Message}";
            return;
        }

        Finish();
    }

    private void SkipFinish() => Finish();

    private void Finish()
    {
        Onboarding.TourCompleted = true;
        Onboarding.SetupStep = 5;
        Onboarding.Save();
        Nav.NavigateTo("/");
    }
}
