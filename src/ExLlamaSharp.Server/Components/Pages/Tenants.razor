@page "/admin/tenants"
@inject AppDbContext Db
@using Microsoft.EntityFrameworkCore

<PageTitle>Tenants — ExLlamaSharp</PageTitle>

<PageHeader Title="Tenants" Subtitle="Multi-tenant administration.">
    <Actions>
        <button class="btn btn-sm btn-primary" @onclick="() => _showCreate = true"><i class="fas fa-plus"></i> New tenant</button>
    </Actions>
</PageHeader>

<div class="stat-grid mb-3">
    <div class="card stat-card"><div class="card-body"><div class="stat-label">Total</div><div class="stat-value">@_tenants.Count</div></div></div>
    <div class="card stat-card"><div class="card-body"><div class="stat-label">Active</div><div class="stat-value">@_tenants.Count(t => t.Active)</div></div></div>
</div>

@if (_showCreate)
{
    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-md-3">
                    <label class="form-label mb-1">Id</label>
                    <input class="form-control form-control-sm" @bind="_newId" placeholder="acme" />
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">Name</label>
                    <input class="form-control form-control-sm" @bind="_newName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label mb-1">Subdomain</label>
                    <input class="form-control form-control-sm" @bind="_newSub" />
                </div>
                <div class="col-md-3 d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => _showCreate = false">Cancel</button>
                    <button class="btn btn-sm btn-primary" @onclick="CreateAsync">Create</button>
                </div>
            </div>
        </div>
    </div>
}

<div class="card card-outline card-primary card-table">
    <div class="card-header"><h3 class="card-title"><i class="fas fa-building mr-2"></i>All tenants</h3></div>
    <div class="card-body p-0">
        <div class="kx-table-wrap">
            <table class="table-clean">
                <thead>
                    <tr><th>Id</th><th>Name</th><th>Subdomain</th><th>Active</th><th>Created</th></tr>
                </thead>
                <tbody>
                    @if (_tenants.Count == 0)
                    {
                        <tr><td colspan="5" class="text-muted">No tenants.</td></tr>
                    }
                    @foreach (var t in _tenants)
                    {
                        <tr>
                            <td><code>@t.Id</code></td>
                            <td>@t.Name</td>
                            <td>@(t.Subdomain ?? "—")</td>
                            <td>
                                @if (t.Active)
                                {
                                    <span class="badge-status badge-ok">active</span>
                                }
                                else
                                {
                                    <span class="badge-status badge-muted">inactive</span>
                                }
                            </td>
                            <td>@t.CreatedAt.ToLocalTime().ToString("d")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert-soft mt-3 text-danger">@_error</div>
}

@code {
    private List<Tenant> _tenants = [];
    private bool _showCreate;
    private string _newId = "";
    private string _newName = "";
    private string _newSub = "";
    private string? _error;

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        try
        {
            _tenants = await Db.Tenants.AsNoTracking().OrderBy(t => t.Name).ToListAsync();
        }
        catch
        {
            _tenants =
            [
                new Tenant { Id = "default", Name = "Default", Active = true, CreatedAt = DateTime.UtcNow },
            ];
        }
    }

    private async Task CreateAsync()
    {
        _error = null;
        if (string.IsNullOrWhiteSpace(_newId) || string.IsNullOrWhiteSpace(_newName))
        {
            _error = "Id and name required.";
            return;
        }

        try
        {
            Db.Tenants.Add(new Tenant
            {
                Id = _newId.Trim().ToLowerInvariant(),
                Name = _newName.Trim(),
                Subdomain = string.IsNullOrWhiteSpace(_newSub) ? null : _newSub.Trim(),
                Active = true,
            });
            await Db.SaveChangesAsync();
            _showCreate = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
    }
}
