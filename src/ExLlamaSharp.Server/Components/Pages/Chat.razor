@page "/chat"
@inject IHttpClientFactory HttpClientFactory
@inject EngineHostService Engine
@inject NavigationManager Nav

<PageTitle>Chat — ExLlamaSharp</PageTitle>

<div class="page-header">
    <h1>Chat playground</h1>
    <p>Stream completions via <code>/v1/chat/completions</code>.</p>
    <p class="small mb-0 @(_modelReady ? "text-success" : "text-danger")">@_modelStatus</p>
</div>

<div class="card chat-layout">
    <div class="chat-messages" @ref="_scroll">
        @foreach (var m in _messages)
        {
            <div class="bubble @m.Role">@m.Text</div>
        }
    </div>
    <div class="chat-input">
        <input class="form-control" placeholder="Ask something…" @bind="_input" @bind:event="oninput"
               @onkeydown="OnKey" disabled="@_streaming" />
        <button class="btn btn-primary" disabled="@_streaming" @onclick="SendAsync">Send</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert-soft mt-3 text-danger">@_error</div>
}

@code {
    private readonly List<UiMsg> _messages =
    [
        new("system", "Playground ready. Messages stream from the OpenAI-compatible API."),
    ];
    private string _input = "";
    private bool _streaming;
    private string? _error;
    private bool _modelReady;
    private string _modelStatus = "Checking model…";
    private ElementReference _scroll;

    protected override void OnInitialized()
    {
        RefreshModelStatus();
    }

    private void RefreshModelStatus()
    {
        _modelReady = Engine.IsLoaded && Engine.IsRunning;
        if (_modelReady)
        {
            var name = Engine.LoadedModelPath is { } p
                ? Path.GetFileName(p.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                : "loaded";
            _modelStatus = $"Using {name}";
        }
        else if (Engine.IsLoaded && Engine.Engine.IsMock)
        {
            _modelStatus = "Mock engine — replies are not from a local GPU model.";
        }
        else
        {
            _modelStatus = "No model loaded. Open Models → My Models and click Load.";
        }
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || _streaming)
        {
            return;
        }

        _error = null;
        RefreshModelStatus();
        var userText = _input.Trim();
        _input = "";
        _messages.Add(new UiMsg("user", userText));
        var assistant = new UiMsg("assistant", "");
        _messages.Add(assistant);
        _streaming = true;

        try
        {
            var client = HttpClientFactory.CreateClient("local-api");
            client.BaseAddress ??= new Uri(Nav.BaseUri);

            var payload = new
            {
                model = Engine.LoadedModelId?.ToString() ?? "default",
                stream = true,
                messages = new[]
                {
                    new { role = "user", content = userText },
                },
            };

            using var req = new HttpRequestMessage(HttpMethod.Post, "v1/chat/completions")
            {
                Content = JsonContent.Create(payload),
            };

            using var res = await client.SendAsync(req, HttpCompletionOption.ResponseHeadersRead);
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                assistant.Text = $"API {(int)res.StatusCode}: {(string.IsNullOrWhiteSpace(body) ? res.ReasonPhrase : body)}";
                if ((int)res.StatusCode == 401)
                {
                    _error = "Unauthorized — sign in on Login or check API Keys. The playground should send the admin key automatically.";
                }
                else if (!_modelReady)
                {
                    _error = "Load a model on the Models page first.";
                }

                return;
            }

            await using var stream = await res.Content.ReadAsStreamAsync();
            using var reader = new StreamReader(stream);
            while (!reader.EndOfStream)
            {
                var line = await reader.ReadLineAsync();
                if (string.IsNullOrWhiteSpace(line))
                {
                    continue;
                }

                if (!line.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var data = line["data:".Length..].Trim();
                if (data == "[DONE]")
                {
                    break;
                }

                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(data);
                    if (doc.RootElement.TryGetProperty("choices", out var choices)
                        && choices.GetArrayLength() > 0)
                    {
                        var delta = choices[0].GetProperty("delta");
                        if (delta.TryGetProperty("content", out var content))
                        {
                            assistant.Text += content.GetString() ?? "";
                            await InvokeAsync(StateHasChanged);
                        }
                    }
                }
                catch
                {
                    // ignore partial JSON
                }
            }

            if (string.IsNullOrEmpty(assistant.Text))
            {
                assistant.Text = "(empty response)";
            }
        }
        catch (Exception ex)
        {
            assistant.Text = $"[offline stub] {userText}";
            _error = $"Stream failed: {ex.Message}";
        }
        finally
        {
            _streaming = false;
        }
    }

    private sealed class UiMsg(string role, string text)
    {
        public string Role { get; } = role;
        public string Text { get; set; } = text;
    }
}
