@page "/chat"
@inject IHttpClientFactory HttpClientFactory
@inject EngineHostService Engine
@inject SettingsService SettingsSvc
@inject NavigationManager Nav
@inject AdminUiSession Session
@inject IJSRuntime Js
@using System.Net.Http.Headers
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.JSInterop

<PageTitle>Chat — ExLlamaSharp</PageTitle>

<PageHeader Title="Chat" Subtitle="Playground for the loaded model." />
<ModelStatusBanner />

<details class="card card-outline card-secondary mb-3 kx-panel-collapsible">
    <summary class="card-body py-2 px-3">Generation parameters</summary>
    <div class="card-body pt-0">
        <div class="form-grid">
            <div>
                <label class="form-label">Model</label>
                <select class="form-select" @bind="_selectedModel">
                    @if (_models.Count == 0)
                    {
                        <option value="">(no models — load one first)</option>
                    }
                    @foreach (var m in _models)
                    {
                        <option value="@m">@m</option>
                    }
                </select>
            </div>
            <div>
                <label class="form-label">Max tokens</label>
                <input type="number" class="form-control" min="64" max="128000" step="64" @bind="_maxTokens" />
            </div>
            <div>
                <label class="form-label">Context (num_ctx)</label>
                <input type="number" class="form-control" min="512" max="128000" step="256" @bind="_numCtx" />
                <div class="form-text kx-help-short">Must match Max batched tokens after reload.</div>
            </div>
            <div>
                <label class="form-label">Temperature</label>
                <input type="number" class="form-control" min="0" max="2" step="0.05" @bind="_temperature" />
            </div>
            <div>
                <label class="form-label">Top P</label>
                <input type="number" class="form-control" min="0" max="1" step="0.05" @bind="_topP" />
            </div>
            <div>
                <label class="form-label">Top K</label>
                <input type="number" class="form-control" min="0" max="200" step="1" @bind="_topK" />
            </div>
            <div>
                <label class="form-label">Min P</label>
                <input type="number" class="form-control" min="0" max="1" step="0.01" @bind="_minP" />
            </div>
            <div>
                <label class="form-label">Repeat penalty</label>
                <input type="number" class="form-control" min="0" max="2" step="0.05" @bind="_repeatPenalty" />
            </div>
            <div>
                <label class="form-label">Image (vision)</label>
                @if (_visionReady)
                {
                    <InputFile OnChange="OnImageSelected" accept="image/*" class="form-control" />
                    @if (!string.IsNullOrEmpty(_imageDataUrl))
                    {
                        <div class="form-text">Attached · <button type="button" class="btn btn-link btn-sm p-0" @onclick="ClearImage">Clear</button></div>
                    }
                }
                else
                {
                    <p class="form-text mb-0">Load a VLM to enable images.</p>
                }
            </div>
            <div style="grid-column:1/-1">
                <label class="form-label">Tools JSON (optional)</label>
                <textarea class="form-control font-monospace" rows="2" @bind="_toolsJson"
                          placeholder='[{"type":"function","function":{"name":"…","parameters":{}}}]'></textarea>
            </div>
        </div>
    </div>
</details>

<div class="card card-outline card-primary chat-layout">
    <div class="chat-messages" @ref="_scroll">
        @foreach (var m in _messages)
        {
            <div class="bubble @m.Role">
                @m.Text
                @if (!string.IsNullOrEmpty(m.ToolCallsJson))
                {
                    <pre class="small mt-2 mb-0">@m.ToolCallsJson</pre>
                }
            </div>
        }
    </div>
    <div class="chat-input">
        <input class="form-control" placeholder="Ask something…" @bind="_input" @bind:event="oninput"
               @onkeydown="OnKey" disabled="@_streaming" />
        <button class="btn btn-sm btn-outline-secondary" disabled="@_streaming" @onclick="ClearChat">Clear</button>
        <button class="btn btn-sm btn-outline-danger" disabled="@(!_streaming)" @onclick="StopChat">Stop</button>
        <button class="btn btn-sm btn-outline-primary" disabled="@(_streaming || !_canRetry)" @onclick="RetryAsync">Retry</button>
        <button class="btn btn-sm btn-primary" disabled="@_streaming" @onclick="SendAsync"><i class="fas fa-paper-plane"></i> Send</button>
    </div>
</div>

@if (!string.IsNullOrEmpty(_numCtxWarning))
{
    <div class="alert-soft mt-3">@_numCtxWarning</div>
}
@if (!string.IsNullOrEmpty(_error))
{
    <div class="alert-soft mt-3 text-danger">@_error</div>
}

@code {
    private readonly List<UiMsg> _messages =
    [
        new("system", "Playground ready. Requests use OpenAI fields plus Ollama-style options."),
    ];
    private string _input = "";
    private bool _streaming;
    private string? _error;
    private string? _numCtxWarning;
    private bool _canRetry;
    private bool _modelReady;
    private bool _visionReady;
    private string _modelStatus = "Checking model…";
    private ElementReference _scroll;
    private List<string> _models = [];
    private string _selectedModel = "";
    private string _toolsJson = "";
    private string? _imageDataUrl;
    private int _maxTokens = 2048;
    private int _numCtx = 8192;
    private float _temperature = 0.7f;
    private float _topP = 0.9f;
    private int _topK = 40;
    private float _minP;
    private float _repeatPenalty = 1.0f;
    private CancellationTokenSource? _sendCts;

    protected override async Task OnInitializedAsync()
    {
        RefreshModelStatus();
        try
        {
            var settings = await SettingsSvc.GetAsync();
            if (settings.DefaultMaxTokens > 0)
            {
                _maxTokens = Math.Clamp(settings.DefaultMaxTokens, 64, 128_000);
            }

            if (settings.MaxBatchedTokens > 0)
            {
                _numCtx = Math.Clamp(settings.MaxBatchedTokens, 512, 128_000);
            }
        }
        catch
        {
            // keep built-in defaults
        }

        await LoadModelsAsync();
    }

    private void RefreshModelStatus()
    {
        _visionReady = Engine.SupportsVision;
        _modelReady = Engine.IsLoaded && Engine.IsRunning && !Engine.Engine.IsMock;
        if (_modelReady)
        {
            var name = Engine.LoadedModelPath is { } p
                ? Path.GetFileName(p.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                : "loaded";
            _modelStatus = _visionReady
                ? $"Using {name} (EXL3 worker + vision)"
                : $"Using {name} (EXL3 worker, text-only)";
        }
        else if (Engine.IsLoaded && Engine.Engine.IsMock)
        {
            _modelStatus = "MOCK engine — replies are fake deterministic tokens, not a GPU model.";
            _visionReady = false;
        }
        else
        {
            _modelStatus = "No model loaded. Open Models → My Models and click Load.";
            _visionReady = false;
        }
    }

    private async Task LoadModelsAsync()
    {
        try
        {
            var client = HttpClientFactory.CreateClient("local-api");
            client.BaseAddress ??= new Uri(Nav.BaseUri);
            var resp = await client.GetAsync("v1/models");
            if (!resp.IsSuccessStatusCode)
            {
                return;
            }

            using var doc = JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
            if (!doc.RootElement.TryGetProperty("data", out var data))
            {
                return;
            }

            _models = data.EnumerateArray()
                .Select(e => e.TryGetProperty("id", out var id) ? id.GetString() : null)
                .Where(s => !string.IsNullOrWhiteSpace(s))
                .Cast<string>()
                .ToList();

            if (string.IsNullOrEmpty(_selectedModel))
            {
                _selectedModel = Engine.LoadedModelId?.ToString("N")
                    ?? _models.FirstOrDefault()
                    ?? "default";
            }
        }
        catch
        {
            _models = [];
            if (string.IsNullOrEmpty(_selectedModel))
            {
                _selectedModel = Engine.LoadedModelId?.ToString("N") ?? "default";
            }
        }
    }

    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        _error = null;
        try
        {
            var file = e.File;
            if (file is null)
            {
                return;
            }

            await using var stream = file.OpenReadStream(maxAllowedSize: 8 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            var b64 = Convert.ToBase64String(ms.ToArray());
            var mime = string.IsNullOrWhiteSpace(file.ContentType) ? "image/png" : file.ContentType;
            _imageDataUrl = $"data:{mime};base64,{b64}";
        }
        catch (Exception ex)
        {
            _error = $"Image attach failed: {ex.Message}";
            _imageDataUrl = null;
        }
    }

    private void ClearImage() => _imageDataUrl = null;

    private void StopChat()
    {
        try { _sendCts?.Cancel(); } catch { /* ignore */ }
    }

    private void ClearChat()
    {
        if (_streaming)
        {
            return;
        }

        _messages.Clear();
        _messages.Add(new("system", "Playground ready. Requests use OpenAI fields plus Ollama-style options."));
        _error = null;
        _numCtxWarning = null;
        _canRetry = false;
    }

    private async Task RetryAsync()
    {
        if (_streaming || !_canRetry)
        {
            return;
        }

        var lastUser = _messages.LastOrDefault(m => m.Role == "user");
        if (lastUser is null)
        {
            return;
        }

        if (_messages.Count > 0 && _messages[^1].Role == "assistant")
        {
            _messages.RemoveAt(_messages.Count - 1);
        }

        _messages.Remove(lastUser);
        _input = lastUser.Text;
        _canRetry = false;
        await SendAsync();
    }

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            await SendAsync();
        }
    }

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_input) || _streaming)
        {
            return;
        }

        _error = null;
        _numCtxWarning = null;
        _canRetry = false;
        RefreshModelStatus();
        var userText = _input.Trim();
        var imageForTurn = _visionReady ? _imageDataUrl : null;
        _imageDataUrl = null;
        _input = "";
        var userMsg = new UiMsg("user", userText);
        _messages.Add(userMsg);
        var assistant = new UiMsg("assistant", "");
        _messages.Add(assistant);
        _streaming = true;
        _sendCts?.Dispose();
        _sendCts = new CancellationTokenSource();
        var ct = _sendCts.Token;

        try
        {
            var client = HttpClientFactory.CreateClient("local-api");
            client.BaseAddress ??= new Uri(Nav.BaseUri);

            var history = _messages
                .Where(m => m.Role is "user" or "assistant" or "system")
                .Where(m => !(m.Role == "assistant" && ReferenceEquals(m, assistant)))
                .Select(m => BuildMessagePayload(m, ReferenceEquals(m, userMsg) ? imageForTurn : null))
                .ToList();

            object? tools = null;
            if (!string.IsNullOrWhiteSpace(_toolsJson))
            {
                try
                {
                    tools = JsonSerializer.Deserialize<JsonElement>(_toolsJson);
                }
                catch (Exception ex)
                {
                    _error = $"Invalid tools JSON: {ex.Message}";
                    assistant.Text = "(invalid tools)";
                    return;
                }
            }

            var maxTokens = Math.Clamp(_maxTokens, 64, 128_000);
            var numCtx = Math.Clamp(_numCtx, 512, 128_000);
            var temperature = Math.Clamp(_temperature, 0f, 2f);
            var topP = Math.Clamp(_topP, 0f, 1f);
            var topK = Math.Clamp(_topK, 0, 200);
            var minP = Math.Clamp(_minP, 0f, 1f);
            var repeatPenalty = Math.Clamp(_repeatPenalty, 0f, 2f);

            // OpenAI top-level + Ollama options (same values mirrored for dual-compatible clients).
            var payload = new Dictionary<string, object?>
            {
                ["model"] = string.IsNullOrWhiteSpace(_selectedModel) ? "default" : _selectedModel,
                ["stream"] = true,
                ["messages"] = history,
                ["max_tokens"] = maxTokens,
                ["temperature"] = temperature,
                ["top_p"] = topP,
                ["top_k"] = topK,
                ["min_p"] = minP,
                ["options"] = new Dictionary<string, object?>
                {
                    ["num_predict"] = maxTokens,
                    ["num_ctx"] = numCtx,
                    ["temperature"] = temperature,
                    ["top_p"] = topP,
                    ["top_k"] = topK,
                    ["min_p"] = minP,
                    // Ollama: 1.0 = off. Only send when the user changed it from neutral.
                    ["repeat_penalty"] = Math.Abs(repeatPenalty - 1f) < 1e-5f ? null : repeatPenalty,
                },
            };
            if (tools is not null)
            {
                payload["tools"] = tools;
            }

            using var req = new HttpRequestMessage(HttpMethod.Post, "v1/chat/completions")
            {
                Content = JsonContent.Create(payload),
            };
            if (!string.IsNullOrWhiteSpace(Session.ApiKey))
            {
                req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", Session.ApiKey);
            }

            using var res = await client.SendAsync(req, HttpCompletionOption.ResponseHeadersRead, ct);
            if (!res.IsSuccessStatusCode)
            {
                var body = await res.Content.ReadAsStringAsync();
                assistant.Text = $"API {(int)res.StatusCode}: {(string.IsNullOrWhiteSpace(body) ? res.ReasonPhrase : body)}";
                if ((int)res.StatusCode == 401)
                {
                    _error = "Session expired — redirecting to Login…";
                    Session.ApiKey = null;
                    try
                    {
                        await Js.InvokeVoidAsync("exLlamaSharpAdmin.logoutSession");
                    }
                    catch (JSException)
                    {
                        try { await Js.InvokeVoidAsync("exLlamaSharpAdmin.clearApiKeyCookie"); } catch (JSException) { }
                    }

                    Nav.NavigateTo("/login", forceLoad: true);
                    return;
                }

                if (!_modelReady)
                {
                    _error = "Load a model on the Models page first.";
                }

                _canRetry = true;
                return;
            }

            if (res.Headers.TryGetValues("X-ExLlamaSharp-NumCtx", out var numCtxHdr))
            {
                var raw = numCtxHdr.FirstOrDefault();
                if (!string.IsNullOrWhiteSpace(raw))
                {
                    _numCtxWarning =
                        $"num_ctx does not match the loaded KV ({raw}). Change Settings → Max batched tokens and reload the model.";
                }
            }

            if (res.Headers.TryGetValues("X-ExLlamaSharp-Engine", out var eng)
                && string.Equals(eng.FirstOrDefault(), "mock", StringComparison.OrdinalIgnoreCase))
            {
                _error = "Warning: response came from the MOCK engine (not GPU EXL3).";
            }

            var toolCallsAcc = new List<string>();
            var finishReason = (string?)null;
            await using var stream = await res.Content.ReadAsStreamAsync(ct);
            using var reader = new StreamReader(stream);
            while (!reader.EndOfStream)
            {
                var line = await reader.ReadLineAsync(ct);
                if (string.IsNullOrWhiteSpace(line))
                {
                    continue;
                }

                if (line.StartsWith(':') && line.Contains("num_ctx", StringComparison.OrdinalIgnoreCase)
                    && string.IsNullOrEmpty(_numCtxWarning))
                {
                    _numCtxWarning =
                        $"num_ctx does not match the loaded KV ({line.TrimStart(':', ' ').Trim()}). Change Settings → Max batched tokens and reload the model.";
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (!line.StartsWith("data:", StringComparison.OrdinalIgnoreCase))
                {
                    continue;
                }

                var data = line["data:".Length..].Trim();
                if (data == "[DONE]")
                {
                    break;
                }

                try
                {
                    using var doc = JsonDocument.Parse(data);
                    if (!doc.RootElement.TryGetProperty("choices", out var choices) || choices.GetArrayLength() == 0)
                    {
                        continue;
                    }

                    var choice = choices[0];
                    if (choice.TryGetProperty("finish_reason", out var fr)
                        && fr.ValueKind == JsonValueKind.String
                        && !string.IsNullOrWhiteSpace(fr.GetString()))
                    {
                        finishReason = fr.GetString();
                    }

                    if (choice.TryGetProperty("delta", out var delta))
                    {
                        if (delta.TryGetProperty("content", out var content))
                        {
                            assistant.Text += content.GetString() ?? "";
                            await InvokeAsync(StateHasChanged);
                        }

                        if (delta.TryGetProperty("tool_calls", out var deltaTools))
                        {
                            toolCallsAcc.Add(deltaTools.GetRawText());
                        }
                    }

                    if (choice.TryGetProperty("message", out var message)
                        && message.TryGetProperty("tool_calls", out var msgTools))
                    {
                        assistant.ToolCallsJson = JsonSerializer.Serialize(
                            msgTools,
                            new JsonSerializerOptions { WriteIndented = true });
                    }
                }
                catch (JsonException)
                {
                    // ignore partial JSON
                }
            }

            if (string.IsNullOrEmpty(assistant.ToolCallsJson) && toolCallsAcc.Count > 0)
            {
                assistant.ToolCallsJson = string.Join("\n", toolCallsAcc);
            }

            if (string.IsNullOrEmpty(assistant.Text) && string.IsNullOrEmpty(assistant.ToolCallsJson))
            {
                assistant.Text = "(empty response)";
            }
            else if (string.Equals(finishReason, "length", StringComparison.OrdinalIgnoreCase))
            {
                _error = $"Reply hit Max tokens ({maxTokens}). Increase max_tokens / num_predict for longer answers.";
                _canRetry = true;
            }
        }
        catch (OperationCanceledException)
        {
            if (string.IsNullOrEmpty(assistant.Text))
            {
                assistant.Text = "(stopped)";
            }

            _error = "Generation stopped.";
            _canRetry = true;
        }
        catch (Exception ex)
        {
            assistant.Text = "(stream failed)";
            _error = $"Stream failed: {ex.Message}";
            _canRetry = true;
        }
        finally
        {
            _streaming = false;
        }
    }

    private static object BuildMessagePayload(UiMsg m, string? imageDataUrl)
    {
        if (m.Role == "user" && !string.IsNullOrEmpty(imageDataUrl))
        {
            return new
            {
                role = m.Role,
                content = new object[]
                {
                    new { type = "text", text = m.Text },
                    new { type = "image_url", image_url = new { url = imageDataUrl } },
                },
            };
        }

        return new { role = m.Role, content = m.Text };
    }

    private sealed class UiMsg(string role, string text)
    {
        public string Role { get; } = role;
        public string Text { get; set; } = text;
        public string? ToolCallsJson { get; set; }
    }
}
