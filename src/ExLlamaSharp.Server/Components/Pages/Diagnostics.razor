@page "/diagnostics"
@rendermode InteractiveServer
@inject HealthService Health

<PageTitle>Diagnostics — ExLlamaSharp</PageTitle>

<div class="page-header">
    <h1>Diagnostics</h1>
    <p>Health checks and common fixes.</p>
</div>

<div class="d-flex gap-2 flex-wrap mb-3">
    <button class="btn btn-primary" disabled="@_busy" @onclick="RunHealth">Run health check</button>
    <button class="btn btn-outline-secondary" disabled="@_busy" @onclick="RunReady">Readiness probe</button>
</div>

@if (_report is not null)
{
    <div class="mb-3">
        <span class="badge-status @StatusClass(_report.Status)">Overall: @_report.Status</span>
        <span class="text-muted small ms-2">@_report.Timestamp.ToLocalTime()</span>
    </div>
    <div class="stat-grid mb-3">
        @foreach (var kv in _report.Components)
        {
            <div class="card">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <strong>@kv.Key</strong>
                        <span class="badge-status @StatusClass(kv.Value.Status)">@kv.Value.Status</span>
                    </div>
                    <div class="text-muted small mt-1">@kv.Value.Detail</div>
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(_readyMsg))
{
    <div class="alert-soft mb-3">@_readyMsg</div>
}

<div class="card">
    <div class="card-body">
        <h5 class="card-title">Common issues</h5>
        <ul class="mb-0">
            <li><strong>No model loaded</strong> — open <a href="/models">Models</a> and load or import one.</li>
            <li><strong>nvidia-smi missing</strong> — GPU metrics fall back to mock; install NVIDIA drivers.</li>
            <li><strong>Database unhealthy</strong> — check SQLite path and disk space.</li>
            <li><strong>Port in use</strong> — change bind port under <a href="/settings">Settings → Network</a>.</li>
            <li><strong>API 401</strong> — create a key on <a href="/keys">API Keys</a>.</li>
        </ul>
    </div>
</div>

@code {
    private HealthReport? _report;
    private string? _readyMsg;
    private bool _busy;

    private async Task RunHealth()
    {
        _busy = true;
        try
        {
            _report = await Health.GetHealthAsync();
        }
        catch (Exception ex)
        {
            _report = new HealthReport
            {
                Status = "unhealthy",
                Timestamp = DateTime.UtcNow,
                Components = new Dictionary<string, ComponentHealth>
                {
                    ["error"] = new ComponentHealth { Status = "unhealthy", Detail = ex.Message },
                },
            };
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RunReady()
    {
        _busy = true;
        try
        {
            var ok = await Health.IsReadyAsync();
            _readyMsg = ok ? "Ready: yes" : "Ready: no (check health components)";
        }
        catch (Exception ex)
        {
            _readyMsg = $"Ready check failed: {ex.Message}";
        }
        finally
        {
            _busy = false;
        }
    }

    private static string StatusClass(string status) => status.ToLowerInvariant() switch
    {
        "healthy" => "badge-ok",
        "degraded" => "badge-warn",
        "unhealthy" => "badge-err",
        _ => "badge-muted",
    };
}
