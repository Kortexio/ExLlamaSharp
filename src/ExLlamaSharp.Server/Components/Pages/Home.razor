@page "/"
@implements IAsyncDisposable
@inject EngineHostService Engine
@inject SettingsService Settings
@inject GpuInfoService GpuInfo
@inject AppDbContext Db
@inject OnboardingState Onboarding
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@using ExLlamaSharp.Server.Hubs

<PageTitle>Dashboard — ExLlamaSharp</PageTitle>

<div class="page-header d-flex justify-content-between align-items-start flex-wrap gap-2">
    <div>
        <h1>Dashboard</h1>
        <p>Server overview for your business.</p>
    </div>
    <button class="btn btn-outline-secondary btn-sm" @onclick="ToggleAdvanced">
        @(ShowAdvanced ? "Hide advanced metrics" : "Show advanced metrics")
    </button>
</div>

<div class="stat-grid mb-3">
    <div class="card stat-card">
        <div class="card-body">
            <div class="stat-label">Status</div>
            <div class="stat-value">@_statusEmoji</div>
            <div class="small text-muted">@_statusText</div>
        </div>
    </div>
    <div class="card stat-card">
        <div class="card-body">
            <div class="stat-label">Requests today</div>
            <div class="stat-value">@_requestsToday</div>
        </div>
    </div>
    <div class="card stat-card">
        <div class="card-body">
            <div class="stat-label">Model</div>
            <div class="stat-value" style="font-size:1.15rem">@_modelLabel</div>
        </div>
    </div>
    <div class="card stat-card">
        <div class="card-body">
            <div class="stat-label">GPU</div>
            <div class="stat-value">@_gpuPct.ToString("0")%</div>
            <div class="progress-thin mt-2"><span style="width:@_gpuPct.ToString("0")%"></span></div>
            <div class="small text-muted mt-1">@_gpuName</div>
        </div>
    </div>
</div>

@if (ShowAdvanced)
{
    <div class="stat-grid mb-3">
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-label">Tokens / sec</div>
                <div class="stat-value">@_tps.ToString("0.0")</div>
            </div>
        </div>
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-label">Jobs waiting</div>
                <div class="stat-value">@_jobsWaiting</div>
            </div>
        </div>
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-label">Jobs running</div>
                <div class="stat-value">@_jobsRunning</div>
            </div>
        </div>
        <div class="card stat-card">
            <div class="card-body">
                <div class="stat-label">VRAM</div>
                <div class="stat-value" style="font-size:1.1rem">@_vramLabel</div>
            </div>
        </div>
    </div>
    <div class="card">
        <div class="card-body">
            <h5 class="card-title">Live metrics (SignalR)</h5>
            <p class="text-muted small mb-2">
                Hub <code>/hubs/dashboard</code> · @_hubStatus
                @if (_liveUtc is DateTime utc)
                {
                    <span>· last push @utc.ToLocalTime().ToString("HH:mm:ss")</span>
                }
            </p>
            @if (_activeJobs.Count > 0)
            {
                <ul class="mb-0 small">
                    @foreach (var j in _activeJobs)
                    {
                        <li><code>@j</code></li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted small mb-0">No active jobs in last broadcast.</p>
            }
        </div>
    </div>
}

@if (!Onboarding.TourCompleted)
{
    <div class="alert-soft mt-3">
        First time here? <a href="/setup">Run the setup wizard</a>.
    </div>
}

@code {
    private bool ShowAdvanced;
    private string _statusEmoji = "🟡";
    private string _statusText = "Checking…";
    private int _requestsToday;
    private string _modelLabel = "—";
    private double _gpuPct;
    private string _gpuName = "—";
    private double _tps;
    private int _jobsWaiting;
    private int _jobsRunning;
    private string _vramLabel = "—";
    private HubConnection? _hub;
    private string _hubStatus = "connecting…";
    private DateTime? _liveUtc;
    private List<string> _activeJobs = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Onboarding.TourCompleted && await IsFirstRunAsync())
        {
            Nav.NavigateTo("/setup");
            return;
        }

        ShowAdvanced = Onboarding.AdvancedMode;
        try
        {
            var s = await Settings.GetAsync();
            ShowAdvanced = ShowAdvanced || s.ShowAdvancedMetrics;
        }
        catch { }

        await RefreshAsync();
        await ConnectHubAsync();
    }

    private async Task ConnectHubAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/dashboard"))
                .WithAutomaticReconnect()
                .Build();

            _hub.On<JsonElement>(DashboardHub.MetricsMethod, payload =>
            {
                _ = InvokeAsync(() =>
                {
                    ApplyLiveMetrics(payload);
                    StateHasChanged();
                });
            });

            _hub.Reconnecting += _ =>
            {
                _hubStatus = "reconnecting…";
                return InvokeAsync(StateHasChanged);
            };
            _hub.Reconnected += _ =>
            {
                _hubStatus = "live";
                return _hub.InvokeAsync("SubscribeAsync", "default");
            };
            _hub.Closed += _ =>
            {
                _hubStatus = "disconnected";
                return InvokeAsync(StateHasChanged);
            };

            await _hub.StartAsync();
            await _hub.InvokeAsync("SubscribeAsync", "default");
            _hubStatus = "live";
        }
        catch (Exception ex)
        {
            _hubStatus = $"unavailable ({ex.Message})";
        }
    }

    private void ApplyLiveMetrics(JsonElement payload)
    {
        if (payload.TryGetProperty("utc", out var utcEl)
            && utcEl.ValueKind == JsonValueKind.String
            && DateTime.TryParse(utcEl.GetString(), out var utc))
        {
            _liveUtc = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        }

        if (payload.TryGetProperty("tokens_per_second", out var tps))
        {
            _tps = tps.GetDouble();
        }

        if (payload.TryGetProperty("jobs_waiting", out var w))
        {
            _jobsWaiting = (int)w.GetInt64();
        }

        if (payload.TryGetProperty("jobs_running", out var r))
        {
            _jobsRunning = (int)r.GetInt64();
        }

        if (payload.TryGetProperty("model_loaded", out var loaded))
        {
            var isLoaded = loaded.GetBoolean();
            if (isLoaded && Engine.IsRunning)
            {
                _statusEmoji = "🟢";
                _statusText = Engine.Engine.IsMock ? "Running (mock engine)" : "Running";
            }
            else if (isLoaded)
            {
                _statusEmoji = "🟡";
                _statusText = "Model loaded, not running";
            }
            else
            {
                _statusEmoji = "🔴";
                _statusText = "No model loaded";
            }
        }

        _activeJobs = [];
        if (payload.TryGetProperty("active_jobs", out var jobs) && jobs.ValueKind == JsonValueKind.Array)
        {
            foreach (var j in jobs.EnumerateArray())
            {
                var id = j.TryGetProperty("job_id", out var jid) ? jid.ToString() : "?";
                var type = j.TryGetProperty("type", out var t) ? t.GetString() : "?";
                var status = j.TryGetProperty("status", out var st) ? st.GetString() : "?";
                var pct = j.TryGetProperty("progress_pct", out var p) ? p.GetDouble() : 0;
                _activeJobs.Add($"{type} {id[..Math.Min(8, id.Length)]}… {status} {pct:0}%");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            try
            {
                await _hub.DisposeAsync();
            }
            catch
            {
            }
        }
    }

    private async Task<bool> IsFirstRunAsync()
    {
        try
        {
            var admin = await Db.Users.FirstOrDefaultAsync(u => u.Role == "admin");
            if (admin is null)
                return true;

            if (ExLlamaSharp.Server.Auth.PasswordHasher.Verify("changeme", admin.PasswordHash))
                return true;

            var settings = await Settings.GetAsync();
            if (string.IsNullOrWhiteSpace(settings.ModelsPath))
                return true;

            return false;
        }
        catch
        {
            return true;
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            if (Engine.IsLoaded && Engine.IsRunning)
            {
                _statusEmoji = "🟢";
                _statusText = Engine.Engine.IsMock ? "Running (mock engine)" : "Running";
            }
            else if (Engine.IsLoaded)
            {
                _statusEmoji = "🟡";
                _statusText = "Model loaded, not running";
            }
            else
            {
                _statusEmoji = "🔴";
                _statusText = "No model loaded";
            }

            _modelLabel = Engine.LoadedModelPath is { } p
                ? Path.GetFileName(p.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                : "None";

            if (Engine.IsLoaded)
            {
                try
                {
                    var m = Engine.Engine.GetMetrics();
                    _tps = m.TokensPerSecond;
                    _jobsWaiting = (int)m.NumJobsWaiting;
                    _jobsRunning = (int)m.NumJobsRunning;
                }
                catch { }
            }
        }
        catch
        {
            _statusEmoji = "🟡";
            _statusText = "Engine unavailable";
        }

        try
        {
            var start = DateTime.UtcNow.Date;
            _requestsToday = await Db.AuditLogs.CountAsync(a => a.Timestamp >= start);
        }
        catch
        {
            _requestsToday = 0;
        }

        var gpu = await GpuInfo.GetPrimaryAsync();
        if (gpu is not null)
        {
            _gpuPct = gpu.UtilizationPct;
            _gpuName = gpu.Name;
            _vramLabel = $"{gpu.MemoryUsedMb:0}/{gpu.MemoryTotalMb:0} MB";
        }
    }

    private void ToggleAdvanced()
    {
        ShowAdvanced = !ShowAdvanced;
        Onboarding.AdvancedMode = ShowAdvanced;
    }
}
