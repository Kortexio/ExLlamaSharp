@page "/"
@implements IAsyncDisposable
@inject EngineHostService Engine
@inject SettingsService Settings
@inject GpuInfoService GpuInfo
@inject AppDbContext Db
@inject OnboardingState Onboarding
@inject NavigationManager Nav
@using Microsoft.EntityFrameworkCore
@using Microsoft.AspNetCore.SignalR.Client
@using System.Text.Json
@using ExLlamaSharp.Server.Hubs

<PageTitle>Dashboard — ExLlamaSharp</PageTitle>

<PageHeader Title="Dashboard" Breadcrumb="Dashboard" Subtitle="Status, requests, and GPU at a glance." />
<ModelStatusBanner />

@if (!ShowAdvanced)
{
    <div class="row exl-actions">
        <div class="col-lg-3 col-md-6 mb-3 d-flex">
            <a class="exl-action-card" href="/models">
                <span class="exl-action-icon bg-models"><i class="fas fa-cube"></i></span>
                <span class="exl-action-body">
                    <strong>Load a model</strong>
                    <span class="exl-action-desc">VRAM profile and start serving</span>
                </span>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 mb-3 d-flex">
            <a class="exl-action-card" href="/chat">
                <span class="exl-action-icon bg-chat"><i class="fas fa-comments"></i></span>
                <span class="exl-action-body">
                    <strong>Try chat</strong>
                    <span class="exl-action-desc">Playground against loaded model</span>
                </span>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 mb-3 d-flex">
            <a class="exl-action-card" href="/settings">
                <span class="exl-action-icon bg-settings"><i class="fas fa-cog"></i></span>
                <span class="exl-action-body">
                    <strong>Settings</strong>
                    <span class="exl-action-desc">Network, context and multi-GPU</span>
                </span>
            </a>
        </div>
        <div class="col-lg-3 col-md-6 mb-3 d-flex">
            <a class="exl-action-card" href="/jobs">
                <span class="exl-action-icon bg-jobs"><i class="fas fa-tasks"></i></span>
                <span class="exl-action-body">
                    <strong>Jobs</strong>
                    <span class="exl-action-desc">Download and quantize progress</span>
                </span>
            </a>
        </div>
    </div>
}

<div class="row exl-stat-row">
    <div class="col-lg-3 col-sm-6 mb-3 d-flex">
        <div class="small-box exl-stat-@_statusTone">
            <div class="inner">
                <h3>@_statusLabel</h3>
                <p>@_statusText</p>
            </div>
            <div class="icon"><i class="fas fa-heartbeat"></i></div>
            <a href="/diagnostics" class="small-box-footer">Diagnostics <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6 mb-3 d-flex">
        <div class="small-box exl-stat-teal">
            <div class="inner">
                <h3>@_requestsToday</h3>
                <p>Requests today</p>
            </div>
            <div class="icon"><i class="fas fa-exchange-alt"></i></div>
            <a href="/usage" class="small-box-footer">Usage <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6 mb-3 d-flex">
        <div class="small-box exl-stat-slate">
            <div class="inner">
                <h3 class="exl-stat-model text-truncate" title="@_modelLabel">@_modelLabel</h3>
                <p>Loaded model</p>
            </div>
            <div class="icon"><i class="fas fa-cube"></i></div>
            <a href="/models" class="small-box-footer">Models <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
    <div class="col-lg-3 col-sm-6 mb-3 d-flex">
        <div class="small-box exl-stat-info">
            <div class="inner">
                <h3>@_gpuPct.ToString("0")<sup class="exl-stat-sup">%</sup></h3>
                <p class="exl-stat-sub text-truncate" title="@_gpuSubtitle">@_gpuSubtitle</p>
                <div class="exl-stat-progress">
                    <span style="width:@_gpuPct.ToString("0")%"></span>
                </div>
            </div>
            <div class="icon"><i class="fas fa-microchip"></i></div>
            <a href="/about" class="small-box-footer">Hardware <i class="fas fa-arrow-circle-right"></i></a>
        </div>
    </div>
</div>

@if (ShowAdvanced)
{
    <div class="row">
        <div class="col-md-3 col-sm-6">
            <div class="info-box">
                <span class="info-box-icon bg-info"><i class="fas fa-tachometer-alt"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Tokens / sec</span>
                    <span class="info-box-number">@_tps.ToString("0.0")</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="info-box">
                <span class="info-box-icon bg-warning"><i class="fas fa-hourglass-half"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Queue waiting</span>
                    <span class="info-box-number">@_jobsWaiting</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="info-box">
                <span class="info-box-icon bg-success"><i class="fas fa-play"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">Jobs running</span>
                    <span class="info-box-number">@_jobsRunning</span>
                </div>
            </div>
        </div>
        <div class="col-md-3 col-sm-6">
            <div class="info-box">
                <span class="info-box-icon bg-danger"><i class="fas fa-memory"></i></span>
                <div class="info-box-content">
                    <span class="info-box-text">VRAM</span>
                    <span class="info-box-number" style="font-size:1rem;">@_vramLabel</span>
                </div>
            </div>
        </div>
    </div>

    <div class="card card-outline card-primary">
        <div class="card-header">
            <h3 class="card-title">Live metrics (SignalR)</h3>
        </div>
        <div class="card-body">
            <p class="text-muted mb-2">
                Hub <code>/hubs/dashboard</code> · @_hubStatus
                @if (_liveUtc is DateTime utc)
                {
                    <span>· last push @utc.ToLocalTime().ToString("HH:mm:ss")</span>
                }
            </p>
            @if (_activeJobs.Count > 0)
            {
                <ul class="mb-0">
                    @foreach (var j in _activeJobs)
                    {
                        <li><code>@j</code></li>
                    }
                </ul>
            }
            else
            {
                <p class="text-muted mb-0">No active jobs in last broadcast.</p>
            }
        </div>
    </div>
}

@if (!Onboarding.TourCompleted)
{
    <div class="alert alert-info mt-3">
        <i class="icon fas fa-info"></i> First time here? <a href="/setup">Run the setup wizard</a>.
    </div>
}

@code {
    private bool ShowAdvanced;
    private string _statusLabel = "…";
    private string _statusText = "Checking…";
    private string _statusTone = "warning";
    private string _gpuSubtitle = "—";
    private int _requestsToday;
    private string _modelLabel = "—";
    private double _gpuPct;
    private string _gpuName = "—";
    private IReadOnlyList<GpuSnapshot> _gpus = [];
    private double _tps;
    private int _jobsWaiting;
    private int _jobsRunning;
    private string _vramLabel = "—";
    private HubConnection? _hub;
    private string _hubStatus = "connecting…";
    private DateTime? _liveUtc;
    private List<string> _activeJobs = [];

    protected override async Task OnInitializedAsync()
    {
        if (!Onboarding.TourCompleted && await IsFirstRunAsync())
        {
            Nav.NavigateTo("/setup");
            return;
        }

        ShowAdvanced = Onboarding.AdvancedMode;
        try
        {
            var s = await Settings.GetAsync();
            ShowAdvanced = ShowAdvanced || s.ShowAdvancedMetrics;
        }
        catch { }

        await RefreshAsync();
        await ConnectHubAsync();
    }

    protected override void OnParametersSet()
    {
        // Keep advanced metrics in sync with shell Simple/Advanced toggle.
        if (Onboarding.AdvancedMode)
        {
            ShowAdvanced = true;
        }
    }

    private async Task ConnectHubAsync()
    {
        try
        {
            _hub = new HubConnectionBuilder()
                .WithUrl(Nav.ToAbsoluteUri("/hubs/dashboard"))
                .WithAutomaticReconnect()
                .Build();

            _hub.On<JsonElement>(DashboardHub.MetricsMethod, payload =>
            {
                _ = InvokeAsync(() =>
                {
                    ApplyLiveMetrics(payload);
                    StateHasChanged();
                });
            });

            _hub.Reconnecting += _ =>
            {
                _hubStatus = "reconnecting…";
                return InvokeAsync(StateHasChanged);
            };
            _hub.Reconnected += _ =>
            {
                _hubStatus = "live";
                return _hub.InvokeAsync("SubscribeAsync", "default");
            };
            _hub.Closed += _ =>
            {
                _hubStatus = "disconnected";
                return InvokeAsync(StateHasChanged);
            };

            await _hub.StartAsync();
            await _hub.InvokeAsync("SubscribeAsync", "default");
            _hubStatus = "live";
        }
        catch (Exception ex)
        {
            _hubStatus = $"unavailable ({ex.Message})";
        }
    }

    private void ApplyLiveMetrics(JsonElement payload)
    {
        if (payload.TryGetProperty("utc", out var utcEl)
            && utcEl.ValueKind == JsonValueKind.String
            && DateTime.TryParse(utcEl.GetString(), out var utc))
        {
            _liveUtc = DateTime.SpecifyKind(utc, DateTimeKind.Utc);
        }

        if (payload.TryGetProperty("tokens_per_second", out var tps))
        {
            _tps = tps.GetDouble();
        }

        if (payload.TryGetProperty("jobs_waiting", out var w))
        {
            _jobsWaiting = (int)w.GetInt64();
        }

        if (payload.TryGetProperty("jobs_running", out var r))
        {
            _jobsRunning = (int)r.GetInt64();
        }

        if (payload.TryGetProperty("model_loaded", out var loaded))
        {
            var isLoaded = loaded.GetBoolean();
            if (isLoaded && Engine.IsRunning)
            {
                ApplyStatus(Engine.Engine.IsMock ? "Mock" : "Online", Engine.Engine.IsMock ? "Running (mock engine)" : "Engine running", "success");
            }
            else if (isLoaded)
            {
                ApplyStatus("Idle", "Model loaded, not running", "warning");
            }
            else
            {
                ApplyStatus("Offline", "No model loaded", "danger");
            }
        }

        _activeJobs = [];
        if (payload.TryGetProperty("active_jobs", out var jobs) && jobs.ValueKind == JsonValueKind.Array)
        {
            foreach (var j in jobs.EnumerateArray())
            {
                var id = j.TryGetProperty("job_id", out var jid) ? jid.ToString() : "?";
                var type = j.TryGetProperty("type", out var t) ? t.GetString() : "?";
                var status = j.TryGetProperty("status", out var st) ? st.GetString() : "?";
                var pct = j.TryGetProperty("progress_pct", out var p) ? p.GetDouble() : 0;
                _activeJobs.Add($"{type} {id[..Math.Min(8, id.Length)]}… {status} {pct:0}%");
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_hub is not null)
        {
            try
            {
                await _hub.DisposeAsync();
            }
            catch
            {
            }
        }
    }

    private async Task<bool> IsFirstRunAsync()
    {
        try
        {
            var admin = await Db.Users.FirstOrDefaultAsync(u => u.Role == "admin");
            if (admin is null)
                return true;

            if (ExLlamaSharp.Server.Auth.PasswordHasher.Verify("changeme", admin.PasswordHash))
                return true;

            var settings = await Settings.GetAsync();
            if (string.IsNullOrWhiteSpace(settings.ModelsPath))
                return true;

            return false;
        }
        catch
        {
            return true;
        }
    }

    private async Task RefreshAsync()
    {
        try
        {
            if (Engine.IsLoaded && Engine.IsRunning)
            {
                ApplyStatus(Engine.Engine.IsMock ? "Mock" : "Online", Engine.Engine.IsMock ? "Running (mock engine)" : "Engine running", "success");
            }
            else if (Engine.IsLoaded)
            {
                ApplyStatus("Idle", "Model loaded, not running", "warning");
            }
            else
            {
                ApplyStatus("Offline", "No model loaded", "danger");
            }

            _modelLabel = Engine.LoadedModelPath is { } p
                ? Path.GetFileName(p.TrimEnd(Path.DirectorySeparatorChar, Path.AltDirectorySeparatorChar))
                : "None";

            if (Engine.IsLoaded)
            {
                try
                {
                    var m = Engine.Engine.GetMetrics();
                    _tps = m.TokensPerSecond;
                    _jobsWaiting = (int)m.NumJobsWaiting;
                    _jobsRunning = (int)m.NumJobsRunning;
                }
                catch { }
            }
        }
        catch
        {
            ApplyStatus("Unknown", "Engine unavailable", "warning");
        }

        try
        {
            var start = DateTime.UtcNow.Date;
            _requestsToday = await Db.AuditLogs.CountAsync(a => a.Timestamp >= start);
        }
        catch
        {
            _requestsToday = 0;
        }

        try
        {
            var all = await GpuInfo.GetGpusAsync();
            string? cvd = null;
            try { cvd = (await Settings.GetAsync()).CudaVisibleDevices; } catch { }
            _gpus = GpuInfoService.FilterVisible(all, cvd);
        }
        catch
        {
            _gpus = [];
        }

        if (_gpus.Count > 0)
        {
            _gpuPct = _gpus.Max(g => g.UtilizationPct);
            _gpuName = _gpus.Count == 1
                ? _gpus[0].Name
                : $"{_gpus.Count} GPUs";
            _gpuSubtitle = _gpus.Count == 1
                ? _gpus[0].Name
                : $"{_gpus.Count} GPUs · max {_gpuPct:0}% load";
            var used = _gpus.Sum(g => g.MemoryUsedMb);
            var total = _gpus.Sum(g => g.MemoryTotalMb);
            _vramLabel = $"{used:0}/{total:0} MB";
        }
        else
        {
            _gpuSubtitle = _gpuName;
        }
    }

    private void ApplyStatus(string label, string text, string tone)
    {
        _statusLabel = label;
        _statusText = text;
        _statusTone = tone;
    }
}
