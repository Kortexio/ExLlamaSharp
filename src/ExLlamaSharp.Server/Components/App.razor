<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0d9488" />
    <base href="/" />
    <title>ExLlamaSharp Admin</title>
    <link rel="manifest" href="manifest.webmanifest" />
    <link rel="icon" href="favicon.ico" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="css/app.css" rel="stylesheet" />
    <link href="css/kortexio-theme.css" rel="stylesheet" />
    <HeadOutlet @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
</head>
<body>
    <div id="kx-connecting" class="kx-connecting">Starting Admin…</div>
    <Routes @rendermode="@(new InteractiveServerRenderMode(prerender: false))" />
    <div id="blazor-error-ui">
        Admin connection lost.
        <a href="" class="reload">Reload</a>
    </div>
    <script src="js/admin-shell.js"></script>
    <script src="_framework/blazor.web.js"></script>
    <script>
        (function () {
            var el = document.getElementById('kx-connecting');
            var started = Date.now();
            var timer = setInterval(function () {
                if (document.querySelector('.kx-shell')) {
                    if (el) el.remove();
                    clearInterval(timer);
                } else if (Date.now() - started > 20000 && el) {
                    el.textContent = 'Could not connect to the Admin server. Reload the page.';
                    clearInterval(timer);
                }
            }, 200);
        })();
    </script>
</body>
</html>
