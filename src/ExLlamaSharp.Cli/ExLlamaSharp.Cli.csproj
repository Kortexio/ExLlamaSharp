<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Must not be case-equivalent to ExLlamaSharp.dll (NuGet ambiguous project name on Windows). -->
    <AssemblyName>ExLlamaSharp.Cli</AssemblyName>
    <RootNamespace>ExLlamaSharp.Cli</RootNamespace>
    <Version>1.0.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ExLlamaSharp\ExLlamaSharp.csproj" />
  </ItemGroup>

</Project>
